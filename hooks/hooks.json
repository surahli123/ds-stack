{
  "description": "ds-step: inject the project brief at session start; deny file-tool edits to .ds-step/, DS-STATE.md and frozen files. Inactive without a .ds-step/ folder.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ds_step_hook.py\" session-start"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ds_step_hook.py\" pre-tool-use"}
        ]
      }
    ]
  }
}
