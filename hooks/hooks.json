{
  "description": "ds-step: inject the project brief at session start; block edits that reopen closed questions, rewrite a running step's card, or touch frozen files. Inactive without a DS-STATE.md.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ds_step_hook.py\" session-start"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ds_step_hook.py\" pre-tool-use"}
        ]
      }
    ]
  }
}
