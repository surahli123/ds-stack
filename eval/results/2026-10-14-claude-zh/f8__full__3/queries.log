{"id": "q10", "ts": 1791955709.628, "source": "runner", "sql": "with qc as (select query_id, max(category) category from query_category group by 1) select count(*) n, sum(searches) s, sum(clicks) c, 100.0*sum(clicks)/sum(searches) ctr, 100.0*sum(clicks)/sum(searches) - 196*sqrt(1.0*sum(clicks)/sum(searches)*(1-1.0*sum(clicks)/sum(searches))/sum(searches)) lo, 100.0*sum(clicks)/sum(searches) + 196*sqrt(1.0*sum(clicks)/sum(searches)*(1-1.0*sum(clicks)/sum(searches))/sum(searches)) hi from query_week w join qc using(query_id) join category_vertical v using(category) where v.vertical='shopping' and w.week='2026-W41'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.006, "row_count": 1, "columns": ["n", "s", "c", "ctr", "lo", "hi"], "rows": [[900, 107810, 39857, 36.96966886188665, 36.68151521326677, 37.257822510506536]]}
