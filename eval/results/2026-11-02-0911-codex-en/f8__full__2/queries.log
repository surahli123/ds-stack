{"id": "q1", "ts": 1793642675.788, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.0, "row_count": 3, "columns": ["name", "sql"], "rows": [["query_week", "CREATE TABLE query_week (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_category", "CREATE TABLE query_category (query_id INTEGER, category TEXT, loaded_at TEXT)"], ["category_vertical", "CREATE TABLE category_vertical (category TEXT, vertical TEXT)"]]}
{"id": "q2", "ts": 1793642685.492, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid FROM query_week GROUP BY week", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid"], "rows": [["2026-W41", 2000, 2000, 239240, 66152, 0]]}
{"id": "q3", "ts": 1793642685.55, "source": "runner", "sql": "SELECT category, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, MIN(loaded_at) AS first_load, MAX(loaded_at) AS last_load FROM query_category GROUP BY category", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 5, "columns": ["category", "rows", "queries", "first_load", "last_load"], "rows": [["apparel", 383, 300, "2026-09-01", "2026-10-09"], ["electronics", 384, 300, "2026-09-01", "2026-10-09"], ["home", 383, 300, "2026-09-01", "2026-10-09"], ["news", 550, 550, "2026-09-01", "2026-09-01"], ["weather", 550, 550, "2026-09-01", "2026-09-01"]]}
{"id": "q4", "ts": 1793642685.607, "source": "runner", "sql": "SELECT category, vertical, COUNT(*) AS rows FROM category_vertical GROUP BY category, vertical", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.0, "row_count": 5, "columns": ["category", "vertical", "rows"], "rows": [["apparel", "shopping", 1], ["electronics", "shopping", 1], ["home", "shopping", 1], ["news", "info", 1], ["weather", "info", 1]]}
{"id": "q5", "ts": 1793642697.84, "source": "runner", "sql": "SELECT COUNT(*) AS query_keys, SUM(CASE WHEN cats>1 THEN 1 ELSE 0 END) AS conflicting_categories, SUM(n-1) AS repeat_rows FROM (SELECT query_id, COUNT(*) AS n, COUNT(DISTINCT category) AS cats FROM query_category GROUP BY query_id)", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["query_keys", "conflicting_categories", "repeat_rows"], "rows": [[2000, 0, 250]]}
{"id": "q6", "ts": 1793642697.902, "source": "runner", "sql": "WITH mappings AS (SELECT DISTINCT query_id, category FROM query_category) SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT w.query_id) AS matched_queries, SUM(CASE WHEN v.vertical='shopping' THEN 1 ELSE 0 END) AS shopping_queries, SUM(CASE WHEN v.vertical='shopping' THEN w.searches ELSE 0 END) AS shopping_searches, SUM(CASE WHEN v.vertical='shopping' THEN w.clicks ELSE 0 END) AS shopping_clicks, SUM(CASE WHEN v.vertical IS NULL THEN 1 ELSE 0 END) AS unmapped FROM query_week w LEFT JOIN mappings m ON w.query_id=m.query_id LEFT JOIN category_vertical v ON m.category=v.category WHERE w.week='2026-W41'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "matched_queries", "shopping_queries", "shopping_searches", "shopping_clicks", "unmapped"], "rows": [[2000, 2000, 900, 107810, 39857, 0]]}
{"id": "q7", "ts": 1793642697.959, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, SUM(w.searches) AS searches, SUM(w.clicks) AS clicks, 100.0*SUM(w.clicks)/SUM(w.searches) AS ctr FROM query_week w JOIN query_category c ON w.query_id=c.query_id JOIN category_vertical v ON c.category=v.category WHERE w.week='2026-W41' AND v.vertical='shopping'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "searches", "clicks", "ctr"], "rows": [[1150, 137945, 56422, 40.901808691869945]]}
{"id": "q8", "ts": 1793642720.935, "source": "runner", "sql": "SELECT COUNT(*) AS shopping_queries, SUM(searches) AS searches, SUM(clicks) AS clicks, 100.0*SUM(clicks)/SUM(searches) AS ctr_percent FROM query_week w WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=w.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.045, "row_count": 1, "columns": ["shopping_queries", "searches", "clicks", "ctr_percent"], "rows": [[900, 107810, 39857, 36.96966886188665]]}
