{"id": "q2", "ts": 1793642044.436, "source": "runner", "sql": "SELECT date, traffic_type, COUNT(*) AS rows, SUM(searches) AS searches, SUM(searches_with_results) AS results, SUM(searches_with_click) AS clicked, SUM(clicks) AS clicks, SUM(CASE WHEN searches_with_click < 0 OR searches_with_click > searches_with_results OR searches_with_results > searches OR searches IS NULL OR searches_with_results IS NULL OR searches_with_click IS NULL THEN 1 ELSE 0 END) AS invalid FROM search_daily_v GROUP BY date, traffic_type ORDER BY date, traffic_type", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 21, "columns": ["date", "traffic_type", "rows", "searches", "results", "clicked", "clicks", "invalid"], "rows": [["2026-10-05", "bot", 2, 15111, 14915, 298, 298, 0], ["2026-10-05", "external", 2, 100216, 92199, 46255, 64757, 0], ["2026-10-05", "internal", 2, 4962, 4763, 3345, 5017, 0], ["2026-10-06", "bot", 2, 15333, 15134, 302, 302, 0], ["2026-10-06", "external", 2, 102451, 94255, 47240, 66136, 0], ["2026-10-06", "internal", 2, 5212, 5003, 3505, 5257, 0], ["2026-10-07", "bot", 2, 14860, 14667, 294, 294, 0], ["2026-10-07", "external", 2, 97105, 89336, 44631, 62484, 0], ["2026-10-07", "internal", 2, 4890, 4694, 3275, 4913, 0], ["2026-10-08", "bot", 2, 15072, 14876, 297, 297, 0], ["2026-10-08", "external", 2, 100215, 92198, 45983, 64376, 0], ["2026-10-08", "internal", 2, 5051, 4849, 3403, 5105, 0], ["2026-10-09", "bot", 2, 14500, 14312, 286, 286, 0], ["2026-10-09", "external", 2, 97205, 89429, 44835, 62769, 0], ["2026-10-09", "internal", 2, 4863, 4669, 3275, 4912, 0], ["2026-10-10", "bot", 2, 14955, 14760, 295, 295, 0], ["2026-10-10", "external", 2, 99533, 91570, 45772, 64081, 0], ["2026-10-10", "internal", 2, 4964, 4766, 3323, 4984, 0], ["2026-10-11", "bot", 2, 15286, 15087, 302, 302, 0], ["2026-10-11", "external", 2, 102057, 93893, 47064, 65889, 0], ["2026-10-11", "internal", 2, 5120, 4915, 3445, 5167, 0]]}
{"id": "q3", "ts": 1793642056.762, "source": "runner", "sql": "WITH totals AS (SELECT SUM(searches_with_click) AS k, SUM(searches_with_results) AS n, SUM(clicks) AS clicks, SUM(searches) AS searches FROM search_daily_v WHERE date BETWEEN '2026-10-05' AND '2026-10-11' AND traffic_type = 'external'), rate AS (SELECT *, 1.0*k/n AS p FROM totals) SELECT k,n,clicks,searches,100*p AS ctr_percent,100*(p+3.841458820694124/(2*n)-1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4.0*n*n)))/(1+3.841458820694124/n) AS wilson_low_percent,100*(p+3.841458820694124/(2*n)+1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4.0*n*n)))/(1+3.841458820694124/n) AS wilson_high_percent,100.0*clicks/n AS clicks_per_results_percent,100.0*k/searches AS clicked_per_all_searches_percent FROM rate", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["k", "n", "clicks", "searches", "ctr_percent", "wilson_low_percent", "wilson_high_percent", "clicks_per_results_percent", "clicked_per_all_searches_percent"], "rows": [[321780, 642880, 450492, 698782, 50.05288700846192, 49.93066407013767, 50.17510931474893, 70.07404181184668, 46.04869615988964]]}
