{"id": "q5", "ts": 1793642040.242, "source": "runner", "sql": "SELECT COUNT(*) AS rows, COUNT(DISTINCT date) AS days, SUM(searches_with_results) AS denominator, SUM(searches_with_click) AS numerator, 100.0*SUM(searches_with_click)/SUM(searches_with_results) AS ctr_pct, SUM(CASE WHEN searches_with_click > searches_with_results OR searches_with_results > searches OR searches_with_click < 0 OR searches_with_results IS NULL OR searches_with_click IS NULL THEN 1 ELSE 0 END) AS invalid_rows FROM search_daily_v WHERE date BETWEEN '2026-10-05' AND '2026-10-11' AND traffic_type = 'external'", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["rows", "days", "denominator", "numerator", "ctr_pct", "invalid_rows"], "rows": [[14, 7, 642880, 321780, 50.05288700846192, 0]]}
