{"id": "q1", "ts": 1793640354.896, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["name", "sql"], "rows": [["query_stats", "CREATE TABLE query_stats (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_labels", "CREATE TABLE query_labels (query_id INTEGER, intent TEXT, label_version INTEGER, is_current INTEGER)"]]}
{"id": "q2", "ts": 1793640361.051, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS distinct_queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid_rows FROM query_stats GROUP BY week ORDER BY week", "params": [], "as_of": "2026-W40", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["week", "rows", "distinct_queries", "searches", "clicks", "invalid_rows"], "rows": [["2026-W40", 1000, 1000, 149500, 55307, 0]]}
{"id": "q3", "ts": 1793640361.108, "source": "runner", "sql": "SELECT intent, label_version, is_current, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS distinct_queries FROM query_labels GROUP BY intent, label_version, is_current", "params": [], "as_of": "2026-W40", "status": "ok", "seconds": 0.0, "row_count": 6, "columns": ["intent", "label_version", "is_current", "rows", "distinct_queries"], "rows": [["informational", 1, 0, 100, 100], ["informational", 1, 1, 400, 400], ["informational", 2, 1, 200, 200], ["navigational", 1, 0, 200, 200], ["navigational", 1, 1, 300, 300], ["navigational", 2, 1, 100, 100]]}
{"id": "q4", "ts": 1793640370.589, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT s.query_id) AS left_queries, COUNT(l.query_id) AS matched_rows, SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_searches, SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END) AS nav_clicks, SUM(CASE WHEN l.intent='navigational' THEN 1 ELSE 0 END) AS nav_queries FROM query_stats s LEFT JOIN query_labels l ON s.query_id=l.query_id AND l.is_current=1 WHERE s.week='2026-W40'", "params": [], "as_of": "2026-W40", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "left_queries", "matched_rows", "nav_searches", "nav_clicks", "nav_queries"], "rows": [[1000, 1000, 1000, 59800, 32878, 400]]}
{"id": "q5", "ts": 1793640370.647, "source": "runner", "sql": "SELECT COUNT(*) AS rows, COUNT(DISTINCT query_id) AS distinct_keys, SUM(CASE WHEN query_id IS NULL OR intent IS NULL THEN 1 ELSE 0 END) AS null_keys_or_intents FROM query_labels WHERE is_current=1", "params": [], "as_of": "2026-W40", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["rows", "distinct_keys", "null_keys_or_intents"], "rows": [[1000, 1000, 0]]}
