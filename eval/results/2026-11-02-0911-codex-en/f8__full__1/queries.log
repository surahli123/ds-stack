{"id": "q1", "ts": 1793642697.134, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.0, "row_count": 3, "columns": ["name", "sql"], "rows": [["query_week", "CREATE TABLE query_week (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_category", "CREATE TABLE query_category (query_id INTEGER, category TEXT, loaded_at TEXT)"], ["category_vertical", "CREATE TABLE category_vertical (category TEXT, vertical TEXT)"]]}
{"id": "q2", "ts": 1793642716.11, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid FROM query_week GROUP BY week", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.002, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid"], "rows": [["2026-W41", 2000, 2000, 239240, 66152, 0]]}
{"id": "q3", "ts": 1793642716.134, "source": "runner", "sql": "SELECT category, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, MIN(loaded_at) AS first_load, MAX(loaded_at) AS last_load FROM query_category GROUP BY category", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 5, "columns": ["category", "rows", "queries", "first_load", "last_load"], "rows": [["apparel", 383, 300, "2026-09-01", "2026-10-09"], ["electronics", 384, 300, "2026-09-01", "2026-10-09"], ["home", 383, 300, "2026-09-01", "2026-10-09"], ["news", 550, 550, "2026-09-01", "2026-09-01"], ["weather", 550, 550, "2026-09-01", "2026-09-01"]]}
{"id": "q4", "ts": 1793642716.155, "source": "runner", "sql": "SELECT category, vertical, COUNT(*) AS rows FROM category_vertical GROUP BY category, vertical", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.0, "row_count": 5, "columns": ["category", "vertical", "rows"], "rows": [["apparel", "shopping", 1], ["electronics", "shopping", 1], ["home", "shopping", 1], ["news", "info", 1], ["weather", "info", 1]]}
{"id": "q5", "ts": 1793642731.059, "source": "runner", "sql": "SELECT COUNT(*) AS queries, SUM(CASE WHEN categories>1 THEN 1 ELSE 0 END) AS conflicting_categories, SUM(n-1) AS extra_rows FROM (SELECT query_id, COUNT(*) AS n, COUNT(DISTINCT category) AS categories FROM query_category GROUP BY query_id)", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["queries", "conflicting_categories", "extra_rows"], "rows": [[2000, 0, 250]]}
{"id": "q6", "ts": 1793642731.087, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT q.query_id) AS matched_queries, SUM(q.searches) AS searches, SUM(q.clicks) AS clicks FROM query_week q JOIN query_category c ON q.query_id=c.query_id JOIN category_vertical v ON c.category=v.category WHERE q.week='2026-W41' AND v.vertical='shopping'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "matched_queries", "searches", "clicks"], "rows": [[1150, 900, 137945, 56422]]}
{"id": "q7", "ts": 1793642731.151, "source": "runner", "sql": "SELECT COUNT(*) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, 100.0*SUM(clicks)/SUM(searches) AS ctr_pct FROM query_week q WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=q.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.041, "row_count": 1, "columns": ["queries", "searches", "clicks", "ctr_pct"], "rows": [[900, 107810, 39857, 36.96966886188665]]}
{"id": "q8", "ts": 1793642749.229, "source": "runner", "sql": "WITH c AS (SELECT DISTINCT query_id, category FROM query_category), mapped AS (SELECT c.query_id, v.vertical FROM c JOIN category_vertical v ON c.category=v.category) SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT q.query_id) AS queries, SUM(CASE WHEN mapped.vertical IS NULL THEN 1 ELSE 0 END) AS unmapped, SUM(CASE WHEN mapped.vertical='shopping' THEN 1 ELSE 0 END) AS shopping_queries FROM query_week q LEFT JOIN mapped ON q.query_id=mapped.query_id WHERE q.week='2026-W41'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.002, "row_count": 1, "columns": ["joined_rows", "queries", "unmapped", "shopping_queries"], "rows": [[2000, 2000, 0, 900]]}
{"id": "q9", "ts": 1793642749.296, "source": "runner", "sql": "SELECT COUNT(*) AS n, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(1.0*searches*searches) AS sum_n2, SUM(1.0*clicks*clicks) AS sum_k2, SUM(1.0*searches*clicks) AS sum_nk FROM query_week q WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=q.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.043, "row_count": 1, "columns": ["n", "searches", "clicks", "sum_n2", "sum_k2", "sum_nk"], "rows": [[900, 107810, 39857, 14834350.0, 2217511.0, 5488096.0]]}
{"id": "q10", "ts": 1793642763.362, "source": "pasted", "sql": "Derived from q9: query-cluster ratio delta-method SE=sqrt(n/(n-1)*sum((clicks-p*searches)^2)/sum(searches)^2); normal 95% CI. Naive CTR from q6.", "params": [], "as_of": "2026-W41", "status": "ok", "row_count": 1, "columns": ["ctr_pct", "ci95_lower_pct", "ci95_upper_pct", "naive_ctr_pct"], "rows": [[36.96966886188665, 36.182772042437946, 37.75656568133535, 40.901808691869945]]}
