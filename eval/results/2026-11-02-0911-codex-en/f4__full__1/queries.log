{"id": "q3", "ts": 1793641160.78, "source": "runner", "sql": "SELECT date, COUNT(*) AS rows, COUNT(DISTINCT hour) AS hours, MIN(hour) AS first_hour, MAX(hour) AS last_hour, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches < 0 OR clicks < 0 OR clicks > searches OR hour NOT BETWEEN 0 AND 23 THEN 1 ELSE 0 END) AS invalid FROM search_hourly GROUP BY date ORDER BY date", "params": [], "as_of": "2026-10-07", "status": "ok", "seconds": 0.0, "row_count": 8, "columns": ["date", "rows", "hours", "first_hour", "last_hour", "searches", "clicks", "invalid"], "rows": [["2026-09-30", 24, 24, 0, 23, 75600, 22554, 0], ["2026-10-01", 24, 24, 0, 23, 77868, 23229, 0], ["2026-10-02", 24, 24, 0, 23, 74088, 22101, 0], ["2026-10-03", 24, 24, 0, 23, 76356, 22776, 0], ["2026-10-04", 24, 24, 0, 23, 73332, 21879, 0], ["2026-10-05", 24, 24, 0, 23, 74844, 22332, 0], ["2026-10-06", 24, 24, 0, 23, 77112, 23007, 0], ["2026-10-07", 10, 10, 0, 9, 19600, 5292, 0]]}
{"id": "q4", "ts": 1793641175.74, "source": "runner", "sql": "SELECT CASE WHEN date='2026-10-07' THEN 'target' ELSE 'baseline' END AS period, CASE WHEN hour<10 THEN '00-09' ELSE '10-23' END AS hours, COUNT(*) AS rows, SUM(searches) AS searches, SUM(clicks) AS clicks, 100.0*SUM(clicks)/SUM(searches) AS ctr_pct FROM search_hourly WHERE date BETWEEN '2026-09-30' AND '2026-10-07' GROUP BY 1,2", "params": [], "as_of": "2026-10-06", "status": "ok", "seconds": 0.0, "row_count": 3, "columns": ["period", "hours", "rows", "searches", "clicks", "ctr_pct"], "rows": [["baseline", "00-09", 70, 137200, 37044, 27.0], ["baseline", "10-23", 98, 392000, 120834, 30.825], ["target", "00-09", 10, 19600, 5292, 27.0]]}
{"id": "q5", "ts": 1793641189.431, "source": "pasted", "sql": "Derived from q4: target loaded-hours CTR minus pooled full-day baseline CTR; Wald independent-binomial 95% CI, delta +/- 1.96*100*sqrt(pa*(1-pa)/na+pb*(1-pb)/nb). Same formula for matched hours.", "params": [], "as_of": "2026-10-06", "status": "ok", "row_count": 1, "columns": ["partial_vs_full_pp", "lo", "hi", "matched_hours_pp", "matched_lo", "matched_hi"], "rows": [[-2.833333333333332, -3.466982958707344, -2.1996837079593203, 0, -0.6644576735955422, 0.6644576735955422]]}
