{"id": "q1", "ts": 1793640366.824, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type IN ('table','view')", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["name", "sql"], "rows": [["query_stats", "CREATE TABLE query_stats (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_labels", "CREATE TABLE query_labels (query_id INTEGER, intent TEXT, label_version INTEGER, is_current INTEGER)"]]}
{"id": "q2", "ts": 1793640372.847, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS distinct_queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid_rows FROM query_stats GROUP BY week ORDER BY week", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["week", "rows", "distinct_queries", "searches", "clicks", "invalid_rows"], "rows": [["2026-W40", 1000, 1000, 149500, 55307, 0]]}
{"id": "q3", "ts": 1793640372.908, "source": "runner", "sql": "SELECT intent, label_version, is_current, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS distinct_queries FROM query_labels GROUP BY intent, label_version, is_current ORDER BY intent,label_version", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 6, "columns": ["intent", "label_version", "is_current", "rows", "distinct_queries"], "rows": [["informational", 1, 0, 100, 100], ["informational", 1, 1, 400, 400], ["informational", 2, 1, 200, 200], ["navigational", 1, 0, 200, 200], ["navigational", 1, 1, 300, 300], ["navigational", 2, 1, 100, 100]]}
{"id": "q4", "ts": 1793640380.226, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT s.query_id) AS distinct_queries, SUM(CASE WHEN l.query_id IS NOT NULL THEN 1 ELSE 0 END) AS matched_rows, SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_searches, SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END) AS nav_clicks, 100.0*SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END)/SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_ctr_pct FROM query_stats s LEFT JOIN query_labels l ON s.query_id=l.query_id AND l.is_current=1 WHERE s.week='2026-W40'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "distinct_queries", "matched_rows", "nav_searches", "nav_clicks", "nav_ctr_pct"], "rows": [[1000, 1000, 1000, 59800, 32878, 54.979933110367895]]}
{"id": "q5", "ts": 1793640380.288, "source": "runner", "sql": "SELECT COUNT(*) AS rows, COUNT(DISTINCT query_id) AS distinct_keys FROM query_labels WHERE is_current=1", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["rows", "distinct_keys"], "rows": [[1000, 1000]]}
{"id": "q6", "ts": 1793640399.417, "source": "pasted", "sql": "Derived from q4: Wilson 95% binomial interval using n=59800 searches and k=32878 clicks; assumes independent binary click outcomes per search.", "params": [], "as_of": "2026-10-04", "status": "ok", "row_count": 1, "columns": ["ctr_pct", "wilson_lower_pct", "wilson_upper_pct"], "rows": [[54.979933110367895, 54.58087409354668, 55.3783523619999]]}
