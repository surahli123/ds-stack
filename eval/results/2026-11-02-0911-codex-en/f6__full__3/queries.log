{"id": "q2", "ts": 1793642125.94, "source": "runner", "sql": "SELECT date, traffic_type, COUNT(*) AS cells, SUM(searches) AS searches, SUM(searches_with_results) AS searches_with_results, SUM(searches_with_click) AS searches_with_click, SUM(clicks) AS clicks FROM search_daily_v GROUP BY date, traffic_type ORDER BY date, traffic_type", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 21, "columns": ["date", "traffic_type", "cells", "searches", "searches_with_results", "searches_with_click", "clicks"], "rows": [["2026-10-05", "bot", 2, 15111, 14915, 298, 298], ["2026-10-05", "external", 2, 100216, 92199, 46255, 64757], ["2026-10-05", "internal", 2, 4962, 4763, 3345, 5017], ["2026-10-06", "bot", 2, 15333, 15134, 302, 302], ["2026-10-06", "external", 2, 102451, 94255, 47240, 66136], ["2026-10-06", "internal", 2, 5212, 5003, 3505, 5257], ["2026-10-07", "bot", 2, 14860, 14667, 294, 294], ["2026-10-07", "external", 2, 97105, 89336, 44631, 62484], ["2026-10-07", "internal", 2, 4890, 4694, 3275, 4913], ["2026-10-08", "bot", 2, 15072, 14876, 297, 297], ["2026-10-08", "external", 2, 100215, 92198, 45983, 64376], ["2026-10-08", "internal", 2, 5051, 4849, 3403, 5105], ["2026-10-09", "bot", 2, 14500, 14312, 286, 286], ["2026-10-09", "external", 2, 97205, 89429, 44835, 62769], ["2026-10-09", "internal", 2, 4863, 4669, 3275, 4912], ["2026-10-10", "bot", 2, 14955, 14760, 295, 295], ["2026-10-10", "external", 2, 99533, 91570, 45772, 64081], ["2026-10-10", "internal", 2, 4964, 4766, 3323, 4984], ["2026-10-11", "bot", 2, 15286, 15087, 302, 302], ["2026-10-11", "external", 2, 102057, 93893, 47064, 65889], ["2026-10-11", "internal", 2, 5120, 4915, 3445, 5167]]}
{"id": "q3", "ts": 1793642139.036, "source": "runner", "sql": "WITH totals AS (SELECT SUM(searches_with_click) AS k, SUM(searches_with_results) AS n, SUM(searches) AS searches, SUM(clicks) AS clicks FROM search_daily_v WHERE date BETWEEN '2026-10-05' AND '2026-10-11' AND traffic_type='external'), stats AS (SELECT *, 1.0*k/n AS p, 1.959963984540054 AS z FROM totals) SELECT k,n,searches,clicks,100*p AS ctr_pct,100*(p+z*z/(2*n)-z*sqrt(p*(1-p)/n+z*z/(4.0*n*n)))/(1+z*z/n) AS wilson_low_pct,100*(p+z*z/(2*n)+z*sqrt(p*(1-p)/n+z*z/(4.0*n*n)))/(1+z*z/n) AS wilson_high_pct,100.0*clicks/searches AS clicks_per_search_pct FROM stats", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["k", "n", "searches", "clicks", "ctr_pct", "wilson_low_pct", "wilson_high_pct", "clicks_per_search_pct"], "rows": [[321780, 642880, 698782, 450492, 50.05288700846192, 49.93066407013767, 50.17510931474893, 64.46817462384548]]}
{"id": "q4", "ts": 1793642139.06, "source": "runner", "sql": "SELECT MIN(date) AS first_date,MAX(date) AS last_date,COUNT(*) AS rows,COUNT(DISTINCT date) AS days,COUNT(DISTINCT date||'|'||platform||'|'||traffic_type) AS unique_keys,SUM(CASE WHEN searches IS NULL OR searches_with_results IS NULL OR searches_with_click IS NULL OR searches_with_click<0 OR searches_with_results<searches_with_click OR searches<searches_with_results THEN 1 ELSE 0 END) AS invalid_rows FROM search_daily_v", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["first_date", "last_date", "rows", "days", "unique_keys", "invalid_rows"], "rows": [["2026-10-05", "2026-10-11", 42, 7, 42, 0]]}
