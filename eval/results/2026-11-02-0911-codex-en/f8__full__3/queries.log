{"id": "q1", "ts": 1793642808.451, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.003, "row_count": 3, "columns": ["name", "sql"], "rows": [["query_week", "CREATE TABLE query_week (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_category", "CREATE TABLE query_category (query_id INTEGER, category TEXT, loaded_at TEXT)"], ["category_vertical", "CREATE TABLE category_vertical (category TEXT, vertical TEXT)"]]}
{"id": "q2", "ts": 1793642813.919, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid FROM query_week GROUP BY week ORDER BY week", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.002, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid"], "rows": [["2026-W41", 2000, 2000, 239240, 66152, 0]]}
{"id": "q3", "ts": 1793642813.944, "source": "runner", "sql": "SELECT category, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, MIN(loaded_at) AS first_load, MAX(loaded_at) AS last_load FROM query_category GROUP BY category", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.001, "row_count": 5, "columns": ["category", "rows", "queries", "first_load", "last_load"], "rows": [["apparel", 383, 300, "2026-09-01", "2026-10-09"], ["electronics", 384, 300, "2026-09-01", "2026-10-09"], ["home", 383, 300, "2026-09-01", "2026-10-09"], ["news", 550, 550, "2026-09-01", "2026-09-01"], ["weather", 550, 550, "2026-09-01", "2026-09-01"]]}
{"id": "q4", "ts": 1793642813.966, "source": "runner", "sql": "SELECT category, vertical, COUNT(*) AS rows FROM category_vertical GROUP BY category, vertical", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 5, "columns": ["category", "vertical", "rows"], "rows": [["apparel", "shopping", 1], ["electronics", "shopping", 1], ["home", "shopping", 1], ["news", "info", 1], ["weather", "info", 1]]}
{"id": "q5", "ts": 1793642832.038, "source": "runner", "sql": "SELECT COUNT(*) AS queries, SUM(CASE WHEN categories>1 THEN 1 ELSE 0 END) AS conflicting_categories, SUM(rows-1) AS extra_rows FROM (SELECT query_id, COUNT(*) AS rows, COUNT(DISTINCT category) AS categories FROM query_category GROUP BY query_id)", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["queries", "conflicting_categories", "extra_rows"], "rows": [[2000, 0, 250]]}
{"id": "q6", "ts": 1793642832.063, "source": "runner", "sql": "WITH qc AS (SELECT DISTINCT query_id, category FROM query_category) SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT w.query_id) AS distinct_queries, SUM(CASE WHEN qc.query_id IS NOT NULL THEN 1 ELSE 0 END) AS category_matches, SUM(CASE WHEN v.category IS NOT NULL THEN 1 ELSE 0 END) AS vertical_matches, SUM(CASE WHEN v.vertical='shopping' THEN 1 ELSE 0 END) AS shopping_queries, SUM(CASE WHEN v.vertical='shopping' THEN w.searches ELSE 0 END) AS shopping_searches, SUM(CASE WHEN v.vertical='shopping' THEN w.clicks ELSE 0 END) AS shopping_clicks FROM query_week w LEFT JOIN qc ON w.query_id=qc.query_id LEFT JOIN category_vertical v ON qc.category=v.category WHERE w.week='2026-W41'", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "distinct_queries", "category_matches", "vertical_matches", "shopping_queries", "shopping_searches", "shopping_clicks"], "rows": [[2000, 2000, 2000, 2000, 900, 107810, 39857]]}
{"id": "q7", "ts": 1793642832.085, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT w.query_id) AS distinct_queries, SUM(w.searches) AS searches, SUM(w.clicks) AS clicks, 100.0*SUM(w.clicks)/SUM(w.searches) AS ctr_pct FROM query_week w JOIN query_category qc ON w.query_id=qc.query_id JOIN category_vertical v ON qc.category=v.category WHERE w.week='2026-W41' AND v.vertical='shopping'", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "distinct_queries", "searches", "clicks", "ctr_pct"], "rows": [[1150, 900, 137945, 56422, 40.901808691869945]]}
{"id": "q8", "ts": 1793642844.274, "source": "runner", "sql": "WITH totals AS (SELECT SUM(w.clicks) AS k, SUM(w.searches) AS n FROM query_week w WHERE w.week='2026-W41' AND EXISTS (SELECT 1 FROM query_category qc WHERE qc.query_id=w.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=qc.category AND v.vertical='shopping'))), rates AS (SELECT k,n,1.0*k/n AS p FROM totals) SELECT k AS clicks,n AS searches,100*p AS ctr_pct,100*(p+3.841458820694/(2*n)-1.95996398454*sqrt(p*(1-p)/n+3.841458820694/(4*n*n)))/(1+3.841458820694/n) AS wilson_lower_pct,100*(p+3.841458820694/(2*n)+1.95996398454*sqrt(p*(1-p)/n+3.841458820694/(4*n*n)))/(1+3.841458820694/n) AS wilson_upper_pct FROM rates", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.04, "row_count": 1, "columns": ["clicks", "searches", "ctr_pct", "wilson_lower_pct", "wilson_upper_pct"], "rows": [[39857, 107810, 36.96966886188665, 36.6819895445383, 37.258276733116574]]}
