{"id": "q1", "ts": 1793646194.422, "source": "runner", "sql": "SELECT CASE WHEN date BETWEEN '2026-09-21' AND '2026-09-27' THEN 'before' ELSE 'after' END AS period, SUM(searches) AS searches, SUM(CASE WHEN platform = 'mobile' THEN searches ELSE 0 END) AS mobile_searches, ROUND(1.0 * SUM(CASE WHEN platform = 'mobile' THEN searches ELSE 0 END) / SUM(searches), 6) AS mobile_share FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY period ORDER BY period DESC", "params": [], "as_of": null, "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["period", "searches", "mobile_searches", "mobile_share"], "rows": [["before", 699605, 280601, 0.401085], ["after", 700366, 385706, 0.550721]]}
{"id": "q2", "ts": 1793646194.489, "source": "runner", "sql": "SELECT platform, country, ROUND(100.0 * SUM(CASE WHEN date >= '2026-09-28' THEN clicks ELSE 0 END) / SUM(CASE WHEN date >= '2026-09-28' THEN searches ELSE 0 END) - 100.0 * SUM(CASE WHEN date <= '2026-09-27' THEN clicks ELSE 0 END) / SUM(CASE WHEN date <= '2026-09-27' THEN searches ELSE 0 END), 6) AS ctr_change_pp FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY platform, country ORDER BY platform, country", "params": [], "as_of": null, "status": "ok", "seconds": 0.0, "row_count": 4, "columns": ["platform", "country", "ctr_change_pp"], "rows": [["desktop", "US", -0.002248], ["desktop", "other", -0.08038], ["mobile", "US", 0.051019], ["mobile", "other", 0.018341]]}
{"id": "q3", "ts": 1793646194.557, "source": "runner", "sql": "SELECT CASE WHEN date <= '2026-09-27' THEN 'before' ELSE 'after' END AS period, ranker, COUNT(DISTINCT date) AS days, COUNT(*) AS segment_day_rows, SUM(searches) AS searches, ROUND(100.0 * SUM(clicks) / SUM(searches), 6) AS ctr_pct FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY period, ranker ORDER BY period DESC, ranker", "params": [], "as_of": null, "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["period", "ranker", "days", "segment_day_rows", "searches", "ctr_pct"], "rows": [["before", "v1", 7, 28, 699605, 30.421166], ["after", "v2", 7, 28, 700366, 28.324333]]}
