{"id": "q1", "ts": 1793646236.208, "source": "runner", "sql": "SELECT CASE WHEN date BETWEEN '2026-09-21' AND '2026-09-27' THEN 'before' ELSE 'after' END AS period, ranker, COUNT(DISTINCT date) AS days, COUNT(*) AS segment_rows, SUM(searches) AS searches, SUM(clicks) AS clicks FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY period, ranker ORDER BY period", "params": [], "as_of": null, "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["period", "ranker", "days", "segment_rows", "searches", "clicks"], "rows": [["after", "v2", 7, 28, 700366, 198374], ["before", "v1", 7, 28, 699605, 212828]]}
{"id": "q2", "ts": 1793646236.278, "source": "runner", "sql": "SELECT platform, country, SUM(CASE WHEN date <= '2026-09-27' THEN searches ELSE 0 END) AS before_searches, SUM(CASE WHEN date >= '2026-09-28' THEN searches ELSE 0 END) AS after_searches, ROUND(100.0*SUM(CASE WHEN date >= '2026-09-28' THEN clicks ELSE 0 END)/SUM(CASE WHEN date >= '2026-09-28' THEN searches ELSE 0 END)-100.0*SUM(CASE WHEN date <= '2026-09-27' THEN clicks ELSE 0 END)/SUM(CASE WHEN date <= '2026-09-27' THEN searches ELSE 0 END), 6) AS ctr_change_pp FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY platform,country ORDER BY platform,country", "params": [], "as_of": null, "status": "ok", "seconds": 0.0, "row_count": 4, "columns": ["platform", "country", "before_searches", "after_searches", "ctr_change_pp"], "rows": [["desktop", "US", 230805, 173266, -0.002248], ["desktop", "other", 188199, 141394, -0.08038], ["mobile", "US", 154512, 211771, 0.051019], ["mobile", "other", 126089, 173935, 0.018341]]}
