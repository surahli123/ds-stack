diff --git a/analyze.py b/analyze.py
new file mode 100644
index 0000000000000000000000000000000000000000..150a56a33a80a74c4c6f9aa04e8f476605cb084a
--- /dev/null
+++ b/analyze.py
@@ -0,0 +1,67 @@
+import json
+import math
+import sqlite3
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent
+db = sqlite3.connect(f'file:{ROOT / "warehouse.db"}?mode=ro', uri=True)
+db.row_factory = sqlite3.Row
+log = []
+
+def query(name, sql):
+    rows = [dict(r) for r in db.execute(sql)]
+    log.append({'check': name, 'sql': sql, 'result': rows})
+    return rows
+
+query('schema', "SELECT name, sql FROM sqlite_master WHERE type IN ('table','view')")
+query('integrity', 'PRAGMA integrity_check')
+query('coverage', 'SELECT MIN(date) AS first_date, MAX(date) AS last_date, COUNT(*) AS rows, COUNT(DISTINCT date) AS days FROM search_daily')
+query('daily coverage and deployment', 'SELECT date, ranker, COUNT(*) AS cells, SUM(searches) AS searches, SUM(clicks) AS clicks FROM search_daily GROUP BY date, ranker ORDER BY date, ranker')
+query('duplicates', 'SELECT date, platform, country, ranker, COUNT(*) AS n FROM search_daily GROUP BY date, platform, country, ranker HAVING COUNT(*) > 1')
+query('invalid or missing fields', 'SELECT * FROM search_daily WHERE date IS NULL OR platform IS NULL OR country IS NULL OR ranker IS NULL OR searches IS NULL OR clicks IS NULL OR searches <= 0 OR clicks < 0 OR clicks > searches OR searches != CAST(searches AS INTEGER) OR clicks != CAST(clicks AS INTEGER)')
+query('release history', 'SELECT * FROM release_log ORDER BY date')
+week = "CASE WHEN date BETWEEN '2026-09-21' AND '2026-09-27' THEN 'pre' ELSE 'post' END"
+where = "date BETWEEN '2026-09-21' AND '2026-10-04'"
+totals = query('weekly totals', f'SELECT {week} AS week, SUM(searches) AS n, SUM(clicks) AS k FROM search_daily WHERE {where} GROUP BY week')
+cells = query('platform country weekly totals', f'SELECT {week} AS week, platform, country, SUM(searches) AS n, SUM(clicks) AS k FROM search_daily WHERE {where} GROUP BY week, platform, country')
+weekday_cells = query('weekday platform country totals', f"SELECT {week} AS week, strftime('%w',date) AS weekday, platform, country, SUM(searches) AS n, SUM(clicks) AS k FROM search_daily WHERE {where} GROUP BY week, weekday, platform, country")
+t = {r['week']: r for r in totals}
+for r in t.values():
+    r['rate'] = r['k'] / r['n']
+
+def interval(value, variance):
+    half = 1.959963984540054 * math.sqrt(variance)
+    return {'estimate_pp': 100 * value, 'ci95_pp': [100 * (value-half), 100 * (value+half)]}
+
+observed = interval(t['post']['rate'] - t['pre']['rate'], sum(r['rate'] * (1-r['rate']) / r['n'] for r in t.values()))
+
+def standardize(rows, keys):
+    groups = {}
+    for r in rows:
+        groups.setdefault(tuple(r[k] for k in keys), {})[r['week']] = r
+    delta = variance = mix = post_std = 0
+    details = []
+    for key, g in sorted(groups.items()):
+        a, b = g['pre'], g['post']
+        pa, pb = a['k']/a['n'], b['k']/b['n']
+        wa, wb = a['n']/t['pre']['n'], b['n']/t['post']['n']
+        delta += wa*(pb-pa)
+        post_std += wa*pb
+        variance += wa**2*(pa*(1-pa)/a['n']+pb*(1-pb)/b['n'])
+        mix += (wb-wa)*pb
+        details.append({'stratum': key, 'pre_weight': wa, 'post_weight': wb, 'pre_ctr_pct': 100*pa, 'post_ctr_pct': 100*pb, **interval(pb-pa, pa*(1-pa)/a['n']+pb*(1-pb)/b['n'])})
+    result = {**interval(delta, variance), 'post_standardized_ctr_pct': 100*post_std, 'composition_component_pp': 100*mix, 'decomposition_error_pp': observed['estimate_pp']-100*(delta+mix), 'strata': details}
+    return result
+
+result = {
+    'metric_assumption': 'CTR = SUM(clicks)/SUM(searches). No metrics.json; binary clicked-search semantics unverified.',
+    'interval_assumption': 'Normal 95% binomial intervals, independent searches and independent periods; standardization weights fixed at observed pre-week shares. Not causal intervals; user/session clustering unavailable.',
+    'totals': t,
+    'observed': observed,
+    'adjusted_platform_country': standardize(cells, ['platform', 'country']),
+    'sensitivity_weekday_platform_country': standardize(weekday_cells, ['weekday', 'platform', 'country']),
+    'causal_identification': 'Not identified: ranker and week perfectly confounded; no contemporaneous control or assignment records.',
+}
+(ROOT/'queries_and_checks.json').write_text(json.dumps(log, ensure_ascii=False, indent=2)+'\n')
+(ROOT/'results.json').write_text(json.dumps(result, ensure_ascii=False, indent=2)+'\n')
+print(json.dumps(result, ensure_ascii=False, indent=2))

