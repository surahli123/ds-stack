#!/usr/bin/env python3
"""Run one ds-mode check on a JSON spec of aggregates.

    python3 checks/run.py <check> --json '<spec>'
    python3 checks/run.py <check> --file spec.json
    python3 checks/run.py --list

Prints one JSON line and appends it to .ds-checks.log in the working directory.
Add "from": "q3" (or a list of query ids) to the spec to record which logged
queries the aggregates came from; the readout cites the printed id, such as
[check:mix_shift#1].
Statuses: pass; flag (a finding the answer must report, not a data defect);
fail (a data or query defect); could_not_run.
Exit code: 0 pass, 1 flag or fail, 2 could not run, 3 usage error.
"""

import argparse
import importlib
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from _common import COULD_NOT_RUN, Result, emit  # noqa: E402

QUERY_ID = re.compile(r"^q\d+$")

CHECKS = ("completeness", "fanout", "mix_shift", "srm")

USAGE = {
    "completeness": ("before reporting any period: is it fully loaded?",
                     '{"series": [{"period": "2026-10-01", "rows": 100}, ...], "target": "2026-10-07"}'),
    "fanout": ("after any join: did it add or lose rows?",
               '{"left_rows": 1000, "joined_rows": 1000, "relationship": "many_to_one", "join": "left", '
               '"right_rows": 1000, "right_distinct_keys": 1000, "matched_left_rows": 1000}'),
    "mix_shift": ("when a rate moved: how much is segment mix vs within-segment change?",
                  '{"segments": [{"name": "web", "before": {"n": 800, "k": 240}, '
                  '"after": {"n": 820, "k": 250}}, ...]}  (n = denominator, k = numerator)'),
    "srm": ("before reading any experiment lift: is the assignment split as planned?",
            '{"observed": [10120, 9880], "expected_ratio": [0.5, 0.5]}'),
}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("check", nargs="?", choices=CHECKS)
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--json", help="the spec as a JSON string")
    source.add_argument("--file", help="path to a JSON spec")
    parser.add_argument("--list", action="store_true", help="list checks, when to run them, and a spec example")
    args = parser.parse_args(argv)

    if args.list:
        for name in CHECKS:
            when, example = USAGE[name]
            print(f"{name}: {when}\n  spec: {example}\n")
        return 0
    if not args.check or not (args.json or args.file):
        parser.print_usage(sys.stderr)
        return 3

    try:
        if args.file:
            with open(args.file) as handle:
                spec = json.load(handle)
        else:
            spec = json.loads(args.json)
        if not isinstance(spec, dict):
            raise ValueError("the spec must be a JSON object")
    except (OSError, ValueError) as err:
        return emit(Result(args.check, COULD_NOT_RUN, f"could not run: unreadable spec ({err})"))

    sources = spec.pop("from", [])
    if isinstance(sources, str):
        sources = [sources]
    if not isinstance(sources, list) or not all(isinstance(s, str) and QUERY_ID.match(s) for s in sources):
        return emit(Result(args.check, COULD_NOT_RUN, "could not run: 'from' must be a query id like \"q3\" or a list of them"))

    module = importlib.import_module(args.check)
    return emit(module.run(spec), sources=sources)


if __name__ == "__main__":
    sys.exit(main())
"""Is the period you are about to report fully loaded?

Compares the target period's row count with the median of earlier periods.
Daily ISO dates are compared with the same weekday (the last `baseline_periods`
same-weekday days, default 4), so a normal Saturday isn't read as a partial
load. With under three weeks of history it falls back to the trailing 7 days
and says so. Any other period labels use the trailing `baseline_periods`
(default 7).
Fails when the target is missing, below `min_ratio` of that median (default
0.9: late or partial data), or above `max_ratio` when given (double loads).
"""

import statistics
from datetime import date

from _common import COULD_NOT_RUN, FAIL, PASS, Result, SpecError, require

NAME = "completeness"
DEFAULT_MIN_RATIO = 0.9
MIN_BASELINE = 3


def _as_date(label):
    try:
        return date.fromisoformat(label)
    except ValueError:
        return None


def run(spec):
    try:
        series = require(spec, "series", list)
        target = require(spec, "target", str)
        min_ratio = float(spec.get("min_ratio", DEFAULT_MIN_RATIO))
        max_ratio = spec.get("max_ratio")
        max_ratio = None if max_ratio is None else float(max_ratio)
        rows = {}
        for point in series:
            period = require(point, "period", str)
            if period in rows:
                raise SpecError(f"period '{period}' appears twice")
            rows[period] = require(point, "rows", int)
    except (SpecError, TypeError, ValueError) as err:
        return Result(NAME, COULD_NOT_RUN, f"could not run: {err}")

    dates = {p: _as_date(p) for p in list(rows) + [target]}
    daily = all(dates.values())
    if daily:
        prior = sorted((p for p in rows if dates[p] < dates[target]), key=dates.get)
        earlier, basis = [], "trailing days"
        if spec.get("same_weekday", True):
            earlier = [p for p in prior if dates[p].weekday() == dates[target].weekday()][-int(spec.get("baseline_periods", 4)):]
            basis = "same weekday"
        if len(earlier) < MIN_BASELINE:
            earlier = prior[-int(spec.get("trailing_days", 7)):]
            basis = "trailing days" if basis == "trailing days" else "trailing days (under 3 weeks of same-weekday history)"
    else:
        k = int(spec.get("baseline_periods", 7))
        earlier = sorted(p for p in rows if p < target)[-k:]
        basis = "trailing periods"
    if len(earlier) < MIN_BASELINE:
        return Result(NAME, COULD_NOT_RUN,
                      f"could not run: need at least {MIN_BASELINE} earlier periods ({basis}) before {target}, got {len(earlier)}")
    baseline = statistics.median(rows[p] for p in earlier)
    details = {"target": target, "basis": basis, "baseline_periods": earlier, "baseline_median_rows": baseline,
               "min_ratio": min_ratio, "max_ratio": max_ratio}
    if target not in rows:
        return Result(NAME, FAIL, f"{target} has no rows loaded", details)
    if baseline == 0:
        return Result(NAME, COULD_NOT_RUN, "could not run: baseline median is 0 rows", details)

    ratio = rows[target] / baseline
    details.update(target_rows=rows[target], ratio=round(ratio, 4))
    summary = f"{target}: {rows[target]} rows = {ratio:.0%} of the {basis} median ({baseline:g})"
    if ratio < min_ratio:
        return Result(NAME, FAIL, "incomplete: " + summary, details)
    if max_ratio is not None and ratio > max_ratio:
        return Result(NAME, FAIL, "possible double load: " + summary, details)
    return Result(NAME, PASS, summary, details)
"""Split a rate change into within-segment (rate) and segment-mix effects.

Kitagawa decomposition with midpoint weights, so the two effects sum exactly to
the overall change:

    delta = sum_s (r_after - r_before) * (w_after + w_before) / 2       # rate effect
          + sum_s (w_after - w_before) * ((r_after + r_before) / 2 - r)  # mix effect

where r is the midpoint of the overall rates. Subtracting r leaves the total
unchanged (the weight changes sum to zero) and makes each segment's mix term
readable: a segment adds to the drop only if its share grew and its rate is
below average, or its share shrank and its rate is above average.

Returns "flag" (a finding the answer must report, not a data defect) when mix
accounts for at least `threshold` of the movement, measured as
|mix| / (|mix| + |rate|) so offsetting effects (Simpson's paradox) still show,
AND the mix effect is larger than noise: at least `min_effect_pp` and at least
`z` standard errors of the overall change. Standard errors are binomial and
assume independent units; clustered units (sessions within users) make them
too small, so treat the intervals as a lower bound on the uncertainty.
"""

import math

from _common import COULD_NOT_RUN, FLAG, PASS, Result, SpecError, require

NAME = "mix_shift"
DEFAULT_THRESHOLD = 0.3
DEFAULT_MIN_EFFECT_PP = 0.1
DEFAULT_Z = 2.0
Z95 = 1.96


def _counts(segment, side):
    part = segment.get(side)
    if not isinstance(part, dict):
        raise SpecError(f"segment '{segment.get('name')}' is missing '{side}'")
    n = require(part, "n", int)
    k = require(part, "k", int)
    if k > n:
        raise SpecError(f"segment '{segment.get('name')}' {side}: k > n")
    return n, k


def _var(rate, n):
    return rate * (1 - rate) / n


def decompose(segments):
    parsed = []
    for segment in segments:
        name = segment.get("name", f"segment_{len(parsed)}")
        nb, kb = _counts(segment, "before")
        na, ka = _counts(segment, "after")
        if nb == 0 or na == 0:
            raise SpecError(f"segment '{name}' has n = 0 on one side; drop it or merge it")
        parsed.append((name, nb, kb, na, ka))
    total_b = sum(p[1] for p in parsed)
    total_a = sum(p[3] for p in parsed)
    overall_b = sum(p[2] for p in parsed) / total_b
    overall_a = sum(p[4] for p in parsed) / total_a
    midpoint = (overall_a + overall_b) / 2

    rate_effect = mix_effect = rate_var = 0.0
    per_segment = []
    for name, nb, kb, na, ka in parsed:
        wb, wa = nb / total_b, na / total_a
        rb, ra = kb / nb, ka / na
        weight = (wa + wb) / 2
        rate_part = (ra - rb) * weight
        mix_part = (wa - wb) * ((ra + rb) / 2 - midpoint)
        rate_effect += rate_part
        mix_effect += mix_part
        rate_var += weight ** 2 * (_var(rb, nb) + _var(ra, na))
        per_segment.append({
            "name": name, "n_before": nb, "n_after": na,
            "weight_before": round(wb, 6), "weight_after": round(wa, 6),
            "rate_before": round(rb, 6), "rate_after": round(ra, 6),
            "rate_effect_pp": round(100 * rate_part, 4), "mix_effect_pp": round(100 * mix_part, 4),
        })
    delta_se = math.sqrt(_var(overall_b, total_b) + _var(overall_a, total_a))
    return {
        "overall_before": overall_b, "overall_after": overall_a, "delta": overall_a - overall_b,
        "delta_se": delta_se, "rate_effect": rate_effect, "rate_effect_se": math.sqrt(rate_var),
        "mix_effect": mix_effect, "segments": per_segment,
        "smallest_segment_n": min(min(p[1], p[3]) for p in parsed),
    }


def _ci_pp(value, se):
    return [round(100 * (value - Z95 * se), 3), round(100 * (value + Z95 * se), 3)]


def run(spec):
    try:
        segments = require(spec, "segments", list)
        if len(segments) < 2:
            raise SpecError("needs at least 2 segments to separate mix from rate")
        threshold = float(spec.get("threshold", DEFAULT_THRESHOLD))
        min_effect_pp = float(spec.get("min_effect_pp", DEFAULT_MIN_EFFECT_PP))
        z = float(spec.get("z", DEFAULT_Z))
        parts = decompose(segments)
    except (SpecError, TypeError, ValueError) as err:
        return Result(NAME, COULD_NOT_RUN, f"could not run: {err}")

    rate, mix, delta = parts["rate_effect"], parts["mix_effect"], parts["delta"]
    moved = abs(rate) + abs(mix)
    share = abs(mix) / moved if moved > 1e-12 else 0.0
    noise_floor = max(min_effect_pp / 100, z * parts["delta_se"])
    details = {
        "overall_before": round(parts["overall_before"], 6),
        "overall_after": round(parts["overall_after"], 6),
        "delta_pp": round(100 * delta, 4),
        "delta_ci95_pp": _ci_pp(delta, parts["delta_se"]),
        "rate_effect_pp": round(100 * rate, 4),
        "rate_effect_ci95_pp": _ci_pp(rate, parts["rate_effect_se"]),
        "mix_effect_pp": round(100 * mix, 4),
        "mix_share": round(share, 4),
        "noise_floor_pp": round(100 * noise_floor, 4),
        "threshold": threshold, "min_effect_pp": min_effect_pp, "z": z,
        "smallest_segment_n": parts["smallest_segment_n"],
        "se_assumes_independent_units": True,
        "segments": parts["segments"],
    }
    lo, hi = details["rate_effect_ci95_pp"]
    summary = (f"overall change {100 * delta:+.2f} pp = within-segment {100 * rate:+.2f} pp "
               f"(95% CI {lo:+.2f} to {hi:+.2f}) + mix {100 * mix:+.2f} pp (mix share {share:.0%})")
    if share >= threshold and abs(mix) >= noise_floor:
        return Result(NAME, FLAG, "mix-dominant: " + summary + "; report the mix shift as part of the answer", details)
    if share >= threshold:
        summary += f"; the mix effect is within noise (floor {100 * noise_floor:.2f} pp)"
    return Result(NAME, PASS, summary, details)
"""Sample ratio mismatch: are assignment counts consistent with the planned split?

Chi-square goodness-of-fit with k - 1 degrees of freedom. Fails when the
p-value is below `alpha` (default 0.001, the usual SRM bar). A failed SRM means
the arms are not comparable, so any lift computed from them is untrustworthy.
"""

import math

from _common import COULD_NOT_RUN, FAIL, PASS, Result, SpecError, require

NAME = "srm"
DEFAULT_ALPHA = 0.001


def _gamma_q(a, x):
    """Regularized upper incomplete gamma Q(a, x) (Numerical Recipes gammq)."""
    if x <= 0:
        return 1.0
    log_prefix = -x + a * math.log(x) - math.lgamma(a)
    if x < a + 1:
        term = total = 1.0 / a
        ap = a
        for _ in range(10_000):
            ap += 1
            term *= x / ap
            total += term
            if abs(term) < abs(total) * 1e-15:
                break
        return max(0.0, 1.0 - total * math.exp(log_prefix))
    b = x + 1 - a
    c = 1 / 1e-300
    d = 1 / b
    h = d
    for i in range(1, 10_000):
        an = -i * (i - a)
        b += 2
        d = an * d + b
        d = 1e-300 if abs(d) < 1e-300 else d
        c = b + an / c
        c = 1e-300 if abs(c) < 1e-300 else c
        d = 1 / d
        delta = d * c
        h *= delta
        if abs(delta - 1) < 1e-15:
            break
    return math.exp(log_prefix) * h


def chi_square_p(observed, ratios):
    total = sum(observed)
    stat = sum((o - total * r) ** 2 / (total * r) for o, r in zip(observed, ratios))
    return stat, _gamma_q((len(observed) - 1) / 2, stat / 2)


def run(spec):
    try:
        observed = require(spec, "observed", list)
        ratios = require(spec, "expected_ratio", list)
        if len(observed) < 2 or len(observed) != len(ratios):
            raise SpecError("'observed' and 'expected_ratio' need the same length, at least 2")
        for count in observed:
            if isinstance(count, bool) or not isinstance(count, int) or count < 0:
                raise SpecError("'observed' must be non-negative integer counts")
        ratios = [float(r) for r in ratios]
        if any(r <= 0 for r in ratios) or abs(sum(ratios) - 1) > 1e-6:
            raise SpecError("'expected_ratio' must be positive and sum to 1")
        if sum(observed) == 0:
            raise SpecError("no units observed")
        alpha = float(spec.get("alpha", DEFAULT_ALPHA))
    except (SpecError, TypeError, ValueError) as err:
        return Result(NAME, COULD_NOT_RUN, f"could not run: {err}")

    stat, p_value = chi_square_p(observed, ratios)
    total = sum(observed)
    shares = [round(o / total, 6) for o in observed]
    details = {"observed": observed, "observed_share": shares, "expected_ratio": ratios,
               "chi2": round(stat, 4), "p_value": p_value, "alpha": alpha}
    summary = f"observed shares {shares} vs expected {ratios}: chi2 {stat:.2f}, p {p_value:.3g}"
    if p_value < alpha:
        return Result(NAME, FAIL, "sample ratio mismatch: " + summary
                      + "; arms are not comparable until the cause is found", details)
    return Result(NAME, PASS, summary, details)
"""Catch joins that silently add or lose rows.

Pass the row counts around a join. Fails when the right side has duplicate keys
for a join meant to be many-to-one or one-to-one, when the left side has
duplicate keys for a one-to-one join, when the join added rows, or
when a left join lost rows. An inner join that drops rows passes with the drop
reported, unless it exceeds `max_drop_fraction`.

Row counts alone miss a fan-out that dropped rows cancel out. Pass
`matched_left_rows` (left rows with at least one match) to catch it: a
many-to-one or one-to-one join can't return more rows than that.
"""

from _common import COULD_NOT_RUN, FAIL, PASS, Result, SpecError, require

NAME = "fanout"
RELATIONSHIPS = {"many_to_one", "one_to_one"}
JOINS = {"left", "inner"}


def run(spec):
    try:
        left_rows = require(spec, "left_rows", int)
        joined_rows = require(spec, "joined_rows", int)
        relationship = spec.get("relationship", "many_to_one")
        join = spec.get("join", "left")
        if relationship not in RELATIONSHIPS:
            raise SpecError(f"'relationship' must be one of {sorted(RELATIONSHIPS)}")
        if join not in JOINS:
            raise SpecError(f"'join' must be one of {sorted(JOINS)}")
        right_rows = spec.get("right_rows")
        right_keys = spec.get("right_distinct_keys")
        if (right_rows is None) != (right_keys is None):
            raise SpecError("pass both 'right_rows' and 'right_distinct_keys', or neither")
        if right_rows is not None:
            right_rows = require(spec, "right_rows", int)
            right_keys = require(spec, "right_distinct_keys", int)
        left_keys = spec.get("left_distinct_keys")
        if left_keys is not None:
            left_keys = require(spec, "left_distinct_keys", int)
        matched = spec.get("matched_left_rows")
        if matched is not None:
            matched = require(spec, "matched_left_rows", int)
            if matched > left_rows:
                raise SpecError("'matched_left_rows' can't exceed 'left_rows'")
        max_drop = spec.get("max_drop_fraction")
    except (SpecError, TypeError, ValueError) as err:
        return Result(NAME, COULD_NOT_RUN, f"could not run: {err}")

    details = {"left_rows": left_rows, "joined_rows": joined_rows,
               "relationship": relationship, "join": join}
    problems = []
    if right_rows is not None:
        details.update(right_rows=right_rows, right_distinct_keys=right_keys)
        if right_rows > right_keys:
            problems.append(
                f"right side has {right_rows - right_keys} duplicate-key rows "
                f"({right_rows} rows for {right_keys} keys); dedupe or filter before joining"
            )
    if relationship == "one_to_one" and left_keys is not None and left_rows > left_keys:
        details["left_distinct_keys"] = left_keys
        problems.append(f"left side has {left_rows - left_keys} duplicate-key rows for a one-to-one join")
    if joined_rows > left_rows:
        problems.append(f"join added {joined_rows - left_rows} rows (fan-out)")
    elif matched is not None:
        expected = matched if join == "inner" else left_rows
        details["matched_left_rows"] = matched
        if joined_rows > expected:
            problems.append(f"join returned {joined_rows} rows for {expected} expected; "
                            "a fan-out is hidden by dropped rows")
    dropped = left_rows - joined_rows if joined_rows < left_rows else 0
    if dropped:
        fraction = dropped / left_rows
        details["dropped_rows"] = dropped
        details["dropped_fraction"] = round(fraction, 6)
        if join == "left":
            problems.append(f"left join lost {dropped} rows; the query is not the join you think")
        elif max_drop is not None and fraction > float(max_drop):
            problems.append(f"inner join dropped {fraction:.1%} of rows (limit {float(max_drop):.1%})")

    if problems:
        return Result(NAME, FAIL, "; ".join(problems), details)
    note = f"; inner join dropped {dropped} rows" if dropped else ""
    return Result(NAME, PASS, f"row counts consistent with a {relationship} {join} join{note}", details)
"""Shared result format and run log for every check.

Every check returns a Result. `emit` prints it as one JSON line and appends it
to .ds-checks.log in the working directory (or to $DS_CHECKS_LOG when set), so
whether a check ran can be read from the log instead of trusted from the
agent's own report. Each logged run gets an id (`mix_shift#2`: the second
mix_shift in this log) for the readout to cite, and records the query ids its
inputs came from (`from`), so a reviewer can trace a check back to its data.
"""

import json
import os
import time
from dataclasses import asdict, dataclass, field

PASS = "pass"
FLAG = "flag"
FAIL = "fail"
COULD_NOT_RUN = "could_not_run"

LOG_NAME = ".ds-checks.log"
EXIT_CODES = {PASS: 0, FLAG: 1, FAIL: 1, COULD_NOT_RUN: 2}


@dataclass
class Result:
    check: str
    status: str
    summary: str
    details: dict = field(default_factory=dict)


class SpecError(ValueError):
    """The spec is missing or malformed, so the check cannot run."""


def require(spec, key, kind):
    if key not in spec:
        raise SpecError(f"missing '{key}'")
    value = spec[key]
    if kind is int:
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise SpecError(f"'{key}' must be a non-negative integer")
    elif not isinstance(value, kind):
        raise SpecError(f"'{key}' must be {kind.__name__}")
    return value


def log_path(log_dir=None):
    return os.environ.get("DS_CHECKS_LOG") or os.path.join(log_dir or os.getcwd(), LOG_NAME)


def read_log(path):
    entries = []
    try:
        with open(path) as handle:
            for line in handle:
                try:
                    entries.append(json.loads(line))
                except ValueError:
                    continue
    except FileNotFoundError:
        pass
    return entries


def emit(result, log_dir=None, sources=None):
    path = log_path(log_dir)
    runs = sum(1 for entry in read_log(path) if entry.get("check") == result.check)
    payload = {"id": f"{result.check}#{runs + 1}", "from": list(sources or []), **asdict(result)}
    print(json.dumps(payload, sort_keys=True))
    with open(path, "a") as log:
        log.write(json.dumps({"ts": round(time.time(), 3), **payload}, sort_keys=True) + "\n")
    return EXIT_CODES[result.status]

