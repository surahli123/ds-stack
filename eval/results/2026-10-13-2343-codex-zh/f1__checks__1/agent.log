import json, sqlite3, subprocess, math
from pathlib import Path
out=Path('analysis_output')
c=sqlite3.connect('file:warehouse.db?mode=ro',uri=True); c.row_factory=sqlite3.Row
queries=[]
def query(sql):
    rows=[dict(r) for r in c.execute(sql)]
    ident=f'q{len(queries)+1}'
    queries.append({'id':ident,'sql':sql,'rows':rows})
    (out/'queries.json').write_text(json.dumps(queries,indent=2))
    return ident, rows
checks=[]
def check(name,spec):
    p=subprocess.run(['python3','checks/run.py',name,'--json',json.dumps(spec)],text=True,capture_output=True)
    r=json.loads(p.stdout); checks.append(r)
    return r
q1,daily=query('SELECT date AS period, count(*) AS rows, sum(searches) AS searches, sum(clicks) AS clicks FROM search_daily GROUP BY date ORDER BY date')
# Test both requested endpoints and every day with sufficient baseline history.
for i,d in enumerate(daily):
    if i>=3:
        check('completeness',{'series':[{'period':x['period'],'rows':x['rows']} for x in daily], 'target':d['period'],'from':q1})
for target in ['2026-09-27','2026-10-04']:
    check('completeness',{'series':[{'period':x['period'],'rows':x['searches']} for x in daily], 'target':target,'from':q1})
q2,segments=query(\"SELECT CASE WHEN date BETWEEN '2026-09-21' AND '2026-09-27' THEN 'before' ELSE 'after' END AS period, platform, country, sum(searches) AS n, sum(clicks) AS k FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY period, platform, country ORDER BY platform,country,period\")
s={}
for r in segments:
    name=r['platform']+'/'+r['country']; s.setdefault(name,{'name':name})[r['period']]={'n':r['n'],'k':r['k']}
mix=check('mix_shift',{'segments':list(s.values()),'from':q2})
q3,rankers=query('SELECT date, ranker, sum(searches) AS searches FROM search_daily GROUP BY date,ranker ORDER BY date,ranker')
q4,releases=query('SELECT * FROM release_log ORDER BY date')
q5,invalid=query('SELECT * FROM search_daily WHERE date IS NULL OR platform IS NULL OR country IS NULL OR ranker IS NULL OR searches IS NULL OR clicks IS NULL OR searches<=0 OR clicks<0 OR clicks>searches')
q6,duplicates=query('SELECT date,platform,country,ranker,count(*) AS n FROM search_daily GROUP BY date,platform,country,ranker HAVING count(*)>1')
q7,schema=query(\"SELECT name,type,sql FROM sqlite_master WHERE type IN ('table','view')\")
res={'checks':checks,'mix':mix['details'],'totals':{},'integrity':{'invalid':len(invalid),'duplicate_keys':len(duplicates)},'interval_method':'Normal 95% binomial intervals assuming independent searches and at most one click per search; adjusted uses fixed midpoint segment weights. These assumptions are not verifiable from aggregate data.'}
for period in ['before','after']:
    n=sum(r['n'] for r in segments if r['period']==period); k=sum(r['k'] for r in segments if r['period']==period)
    mobile=sum(r['n'] for r in segments if r['period']==period and r['platform']=='mobile')
    res['totals'][period]={'searches':n,'clicks':k,'ctr':k/n,'mobile_share':mobile/n}
(out/'results.json').write_text(json.dumps(res,indent=2))
print(json.dumps({'mix':res['mix'],'totals':res['totals'],'integrity':res['integrity'],'completeness':[(x['details'].get('target'),x['status'],x['summary']) for x in checks if x['check']=='completeness']},indent=2))
