+import sqlite3
+import json
+import math
+import hashlib
+from pathlib import Path
+from statistics import mean, stdev
+from scipy.stats import t
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / 'analysis_output'
+db = sqlite3.connect(f'file:{ROOT / "warehouse.db"}?mode=ro', uri=True)
+db.row_factory = sqlite3.Row
+queries = []
+
+def query(sql):
+    rows = [dict(r) for r in db.execute(sql)]
+    queries.append({'sql': sql, 'rows': rows})
+    return rows
+
+schema = query("SELECT name, sql FROM sqlite_master WHERE type IN ('table','view')")
+releases = query('SELECT * FROM release_log ORDER BY date')
+rows = query("SELECT * FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' ORDER BY date, platform, country")
+coverage = query('SELECT MIN(date) AS first_date, MAX(date) AS last_date, COUNT(*) AS rows FROM search_daily')
+duplicates = query('SELECT date, platform, country, ranker, COUNT(*) AS n FROM search_daily GROUP BY date, platform, country, ranker HAVING COUNT(*) > 1')
+invalid = query('SELECT * FROM search_daily WHERE date IS NULL OR platform IS NULL OR country IS NULL OR ranker IS NULL OR searches IS NULL OR clicks IS NULL OR searches <= 0 OR clicks < 0 OR clicks > searches OR searches != CAST(searches AS INTEGER) OR clicks != CAST(clicks AS INTEGER)')
+cells = query("SELECT CASE WHEN date < '2026-09-28' THEN 'pre' ELSE 'post' END AS period, platform, country, SUM(searches) AS n, SUM(clicks) AS c FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04' GROUP BY period, platform, country ORDER BY period, platform, country")
+groups = sorted({(r['platform'],r['country']) for r in rows})
+data = {period: {(r['platform'],r['country']):r for r in cells if r['period']==period} for period in ['pre','post']}
+totals = {k: {'searches':sum(x['n'] for x in v.values()), 'clicks':sum(x['c'] for x in v.values())} for k,v in data.items()}
+for v in totals.values():
+    v['ctr'] = v['clicks']/v['searches']
+w = {k:{g:data[k][g]['n']/totals[k]['searches'] for g in groups} for k in data}
+p = {k:{g:data[k][g]['c']/data[k][g]['n'] for g in groups} for k in data}
+
+def interval(estimate, variance):
+    se=math.sqrt(variance)
+    return {'pp':100*estimate, 'ci95_pp':[100*(estimate-1.959963984540054*se),100*(estimate+1.959963984540054*se)]}
+
+observed = interval(totals['post']['ctr']-totals['pre']['ctr'],sum(v['ctr']*(1-v['ctr'])/v['searches'] for v in totals.values()))
+adjusted = {}
+for reference in ['pre','post']:
+    weights=w[reference]
+    estimate=sum(weights[g]*(p['post'][g]-p['pre'][g]) for g in groups)
+    variance=sum(weights[g]**2*sum(p[k][g]*(1-p[k][g])/data[k][g]['n'] for k in data) for g in groups)
+    adjusted[reference]=interval(estimate,variance)
+composition=sum((w['post'][g]-w['pre'][g])*p['post'][g] for g in groups)
+strata = [{'platform':g[0],'country':g[1], 'pre_ctr_pct':100*p['pre'][g], 'post_ctr_pct':100*p['post'][g], 'pre_share_pct':100*w['pre'][g], 'post_share_pct':100*w['post'][g], 'difference_pp':100*(p['post'][g]-p['pre'][g])} for g in groups]
+
+# Sensitivity to the independence-of-searches assumption: pair matching weekdays,
+# treating seven day-pair differences as independent observations. This uses
+# equal day weights and is a slightly different estimand from weekly pooled CTR.
+dates=sorted({r['date'] for r in rows})
+daily={date:{(r['platform'],r['country']):r for r in rows if r['date']==date} for date in dates}
+paired={'observed':[], 'adjusted_pre_weights':[]}
+for d0,d1 in zip(dates[:7],dates[7:]):
+    a,b=daily[d0],daily[d1]
+    paired['observed'].append(sum(r['clicks'] for r in b.values())/sum(r['searches'] for r in b.values())-sum(r['clicks'] for r in a.values())/sum(r['searches'] for r in a.values()))
+    paired['adjusted_pre_weights'].append(sum(w['pre'][g]*(b[g]['clicks']/b[g]['searches']-a[g]['clicks']/a[g]['searches']) for g in groups))
+paired_result={}
+for name,values in paired.items():
+    est=mean(values)
+    half=t.ppf(.975,6)*stdev(values)/math.sqrt(7)
+    paired_result[name]={'pp':100*est,'ci95_pp':[100*(est-half),100*(est+half)],'daily_differences_pp':[100*v for v in values]}
+
+result={'database_sha256':hashlib.sha256((ROOT/'warehouse.db').read_bytes()).hexdigest(), 'totals':totals, 'observed':observed, 'adjusted':adjusted, 'strata':strata, 'composition_pp_using_post_rates':100*composition, 'decomposition_residual_pp':observed['pp']-adjusted['pre']['pp']-100*composition, 'paired_weekday_t_sensitivity':paired_result, 'checks':{'duplicate_keys':len(duplicates),'invalid_rows':len(invalid),'days':len(dates),'rows_per_day':{d:len(daily[d]) for d in dates},'complete_observed_grid':len(rows)==56 and all(len(daily[d])==4 for d in dates), 'pre_rankers':sorted({r['ranker'] for r in rows if r['date']<'2026-09-28'}),'post_rankers':sorted({r['ranker'] for r in rows if r['date']>='2026-09-28'})}, 'interval_method':'Independent binomial searches; observed weights fixed. Metric assumes clicks counts searches with a click. Day-pair t sensitivity assumes independent matched weekday pairs; only seven pairs.', 'identification':'Ranker and week perfectly confounded; no contemporaneous control or randomization. Adjusted difference is descriptive, not causal.'}
+(OUT/'queries_and_results.json').write_text(json.dumps(queries,indent=2)+'\n')
+(OUT/'results.json').write_text(json.dumps(result,indent=2)+'\n')
+print(json.dumps(result,indent=2))

