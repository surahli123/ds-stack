+result={'database_sha256':hashlib.sha256((ROOT/'warehouse.db').read_bytes()).hexdigest(), 'totals':totals, 'observed':observed, 'adjusted':adjusted, 'strata':strata, 'composition_pp_using_post_rates':100*composition, 'decomposition_residual_pp':observed['pp']-adjusted['pre']['pp']-100*composition, 'paired_weekday_t_sensitivity':paired_result, 'checks':{'duplicate_keys':len(duplicates),'invalid_rows':len(invalid),'days':len(dates),'rows_per_day':{d:len(daily[d]) for d in dates},'complete_observed_grid':len(rows)==56 and all(len(daily[d])==4 for d in dates), 'pre_rankers':sorted({r['ranker'] for r in rows if r['date']<'2026-09-28'}),'post_rankers':sorted({r['ranker'] for r in rows if r['date']>='2026-09-28'})}, 'interval_method':'Independent binomial searches; observed weights fixed. Metric assumes clicks counts searches with a click. Day-pair t sensitivity assumes independent matched weekday pairs; only seven pairs.', 'identification':'Ranker and week perfectly confounded; no contemporaneous control or randomization. Adjusted difference is descriptive, not causal.'}
