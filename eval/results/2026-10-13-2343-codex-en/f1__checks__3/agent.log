def check(name, spec, filename):
    path = OUT / filename
    path.write_text(json.dumps(spec, indent=2))
    result = subprocess.run(['python3','checks/run.py',name,'--file',str(path)], cwd=ROOT, text=True, capture_output=True)
    checks.append(json.loads(result.stdout))
    print(result.stdout.strip())
