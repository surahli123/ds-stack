import json
from pathlib import Path
import sqlite3
import subprocess

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / 'analysis_output'
c = sqlite3.connect(f'file:{ROOT / \"warehouse.db\"}?mode=ro', uri=True)
c.row_factory = sqlite3.Row
log = []
def query(qid, sql):
    rows = [dict(r) for r in c.execute(sql)]
    log.append({'id': qid, 'sql': sql, 'results': rows})
    (OUT / 'queries.json').write_text(json.dumps(log, indent=2))
    return rows

schema = query('q1', \"SELECT name, sql FROM sqlite_master WHERE type IN ('table','view')\")
daily = query('q2', \"SELECT date, COUNT(*) AS rows, SUM(searches) AS searches, SUM(clicks) AS clicks FROM search_daily GROUP BY date ORDER BY date\")
segments = query('q3', \"\"\"SELECT CASE WHEN date BETWEEN '2026-09-21' AND '2026-09-27' THEN 'before' ELSE 'after' END AS period,
platform, country, SUM(searches) AS n, SUM(clicks) AS k
FROM search_daily WHERE date BETWEEN '2026-09-21' AND '2026-10-04'
GROUP BY period, platform, country ORDER BY platform,country,period\"\"\")
