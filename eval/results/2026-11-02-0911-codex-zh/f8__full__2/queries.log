{"id": "q5", "ts": 1793645894.206, "source": "runner", "sql": "SELECT COUNT(*) AS query_ids, SUM(CASE WHEN n>1 THEN 1 ELSE 0 END) AS repeated_ids, SUM(CASE WHEN cats>1 THEN 1 ELSE 0 END) AS conflicting_ids FROM (SELECT query_id, COUNT(*) AS n, COUNT(DISTINCT category) AS cats FROM query_category GROUP BY query_id)", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["query_ids", "repeated_ids", "conflicting_ids"], "rows": [[2000, 250, 0]]}
{"id": "q6", "ts": 1793645894.231, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT q.query_id) AS matched_queries, SUM(q.searches) AS searches, SUM(q.clicks) AS clicks FROM query_week q JOIN query_category c ON q.query_id=c.query_id JOIN category_vertical v ON c.category=v.category WHERE q.week='2026-W41' AND v.vertical='shopping'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "matched_queries", "searches", "clicks"], "rows": [[1150, 900, 137945, 56422]]}
{"id": "q7", "ts": 1793645894.254, "source": "runner", "sql": "WITH c AS (SELECT DISTINCT query_id, category FROM query_category) SELECT v.vertical, COUNT(*) AS rows, COUNT(DISTINCT q.query_id) AS queries, SUM(q.searches) AS searches, SUM(q.clicks) AS clicks, 100.0*SUM(q.clicks)/SUM(q.searches) AS ctr_pct FROM query_week q LEFT JOIN c ON q.query_id=c.query_id LEFT JOIN category_vertical v ON c.category=v.category WHERE q.week='2026-W41' GROUP BY v.vertical", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 2, "columns": ["vertical", "rows", "queries", "searches", "clicks", "ctr_pct"], "rows": [["info", 1100, 1100, 131430, 26295, 20.006847751654874], ["shopping", 900, 900, 107810, 39857, 36.96966886188665]]}
{"id": "q8", "ts": 1793645905.785, "source": "runner", "sql": "WITH c AS (SELECT DISTINCT query_id, category FROM query_category) SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT q.query_id) AS queries, COUNT(c.query_id) AS matched FROM query_week q LEFT JOIN c ON q.query_id=c.query_id WHERE q.week='2026-W41'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "queries", "matched"], "rows": [[2000, 2000, 2000]]}
{"id": "q9", "ts": 1793645905.85, "source": "runner", "sql": "WITH s AS (SELECT SUM(clicks)*1.0 AS k, SUM(searches)*1.0 AS n FROM query_week q WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=q.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))), t AS (SELECT *, k/n AS p FROM s) SELECT k,n,100*p AS ctr_pct,100*(p+3.841458820694124/(2*n)-1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_lower_pct,100*(p+3.841458820694124/(2*n)+1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_upper_pct FROM t", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.042, "row_count": 1, "columns": ["k", "n", "ctr_pct", "wilson_lower_pct", "wilson_upper_pct"], "rows": [[39857.0, 107810.0, 36.96966886188665, 36.6819895445383, 37.25827673311658]]}
