{"id": "q3", "ts": 1793645841.916, "source": "runner", "sql": "SELECT week,COUNT(*) AS rows,COUNT(DISTINCT query_id) AS queries,SUM(searches) AS searches,SUM(clicks) AS clicks,SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid FROM query_week GROUP BY week ORDER BY week", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid"], "rows": [["2026-W41", 2000, 2000, 239240, 66152, 0]]}
{"id": "q4", "ts": 1793645841.948, "source": "runner", "sql": "SELECT category,COUNT(*) AS rows,COUNT(DISTINCT query_id) AS queries,MIN(loaded_at) AS min_loaded,MAX(loaded_at) AS max_loaded FROM query_category GROUP BY category", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 5, "columns": ["category", "rows", "queries", "min_loaded", "max_loaded"], "rows": [["apparel", 383, 300, "2026-09-01", "2026-10-09"], ["electronics", 384, 300, "2026-09-01", "2026-10-09"], ["home", 383, 300, "2026-09-01", "2026-10-09"], ["news", 550, 550, "2026-09-01", "2026-09-01"], ["weather", 550, 550, "2026-09-01", "2026-09-01"]]}
