{"id": "q6", "ts": 1793645853.631, "source": "runner", "sql": "SELECT COUNT(*) AS ids,SUM(CASE WHEN n>1 THEN 1 ELSE 0 END) AS duplicate_ids,SUM(CASE WHEN cats>1 THEN 1 ELSE 0 END) AS conflicting_ids FROM (SELECT query_id,COUNT(*) n,COUNT(DISTINCT category) cats FROM query_category GROUP BY query_id)", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["ids", "duplicate_ids", "conflicting_ids"], "rows": [[2000, 250, 0]]}
{"id": "q7", "ts": 1793645853.654, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows,COUNT(DISTINCT w.query_id) AS matched_ids,SUM(CASE WHEN v.vertical='shopping' THEN w.searches ELSE 0 END) AS shopping_searches,SUM(CASE WHEN v.vertical='shopping' THEN w.clicks ELSE 0 END) AS shopping_clicks FROM query_week w JOIN query_category c ON w.query_id=c.query_id JOIN category_vertical v ON c.category=v.category WHERE w.week='2026-W41'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "matched_ids", "shopping_searches", "shopping_clicks"], "rows": [[2250, 2000, 137945, 56422]]}
{"id": "q8", "ts": 1793645853.715, "source": "runner", "sql": "SELECT COUNT(*) AS queries,SUM(searches) AS searches,SUM(clicks) AS clicks,100.0*SUM(clicks)/SUM(searches) AS ctr_pct FROM query_week w WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=w.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.04, "row_count": 1, "columns": ["queries", "searches", "clicks", "ctr_pct"], "rows": [[900, 107810, 39857, 36.96966886188665]]}
{"id": "q9", "ts": 1793645874.189, "source": "runner", "sql": "WITH c AS (SELECT DISTINCT query_id,category FROM query_category), j AS (SELECT w.query_id,w.searches,w.clicks,c.category FROM query_week w LEFT JOIN c ON c.query_id=w.query_id WHERE w.week='2026-W41') SELECT COUNT(*) AS joined_rows,COUNT(DISTINCT query_id) AS ids,SUM(CASE WHEN category IS NOT NULL THEN 1 ELSE 0 END) AS matched FROM j", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "ids", "matched"], "rows": [[2000, 2000, 2000]]}
{"id": "q10", "ts": 1793645874.217, "source": "runner", "sql": "WITH c AS (SELECT DISTINCT query_id,category FROM query_category), j AS (SELECT w.query_id,w.searches,w.clicks,c.category FROM query_week w LEFT JOIN c ON c.query_id=w.query_id WHERE w.week='2026-W41') SELECT COUNT(*) AS joined_rows,COUNT(DISTINCT j.query_id) AS ids,COUNT(v.vertical) AS matched,SUM(CASE WHEN v.vertical='shopping' THEN searches ELSE 0 END) AS searches,SUM(CASE WHEN v.vertical='shopping' THEN clicks ELSE 0 END) AS clicks FROM j LEFT JOIN category_vertical v ON j.category=v.category", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "ids", "matched", "searches", "clicks"], "rows": [[2000, 2000, 2000, 107810, 39857]]}
{"id": "q11", "ts": 1793645874.282, "source": "runner", "sql": "WITH a AS (SELECT COUNT(*) AS n,SUM(searches) AS searches,SUM(clicks) AS clicks FROM query_week w WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=w.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))), b AS (SELECT *,1.0*clicks/searches AS p FROM a) SELECT n,searches,clicks,100*p AS ctr_pct,100*(p+3.841458820694124/(2*searches)-1.959963984540054*SQRT(p*(1-p)/searches+3.841458820694124/(4.0*searches*searches)))/(1+3.841458820694124/searches) AS wilson_low_pct,100*(p+3.841458820694124/(2*searches)+1.959963984540054*SQRT(p*(1-p)/searches+3.841458820694124/(4.0*searches*searches)))/(1+3.841458820694124/searches) AS wilson_high_pct FROM b", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.041, "row_count": 1, "columns": ["n", "searches", "clicks", "ctr_pct", "wilson_low_pct", "wilson_high_pct"], "rows": [[900, 107810, 39857, 36.96966886188665, 36.6819895445383, 37.25827673311658]]}
