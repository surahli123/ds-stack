{"id": "q8", "ts": 1793645965.948, "source": "runner", "sql": "SELECT COUNT(*) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, 100.0*SUM(clicks)/SUM(searches) AS ctr_pct FROM query_week w WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c WHERE c.query_id=w.query_id AND EXISTS (SELECT 1 FROM category_vertical v WHERE v.category=c.category AND v.vertical='shopping'))", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.041, "row_count": 1, "columns": ["queries", "searches", "clicks", "ctr_pct"], "rows": [[900, 107810, 39857, 36.96966886188665]]}
{"id": "q9", "ts": 1793645982.612, "source": "runner", "sql": "WITH s AS (SELECT SUM(clicks)*1.0 AS k, SUM(searches)*1.0 AS n FROM query_week w WHERE week='2026-W41' AND EXISTS (SELECT 1 FROM query_category c JOIN category_vertical v ON c.category=v.category WHERE c.query_id=w.query_id AND v.vertical='shopping')), p AS (SELECT k,n,k/n AS p FROM s) SELECT k,n,100*p AS ctr_pct,100*(p+3.841458820694124/(2*n)-1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_low_pct,100*(p+3.841458820694124/(2*n)+1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_high_pct FROM p", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.047, "row_count": 1, "columns": ["k", "n", "ctr_pct", "wilson_low_pct", "wilson_high_pct"], "rows": [[39857.0, 107810.0, 36.96966886188665, 36.6819895445383, 37.25827673311658]]}
{"id": "q10", "ts": 1793645982.633, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, SUM(w.searches) AS searches, SUM(w.clicks) AS clicks, 100.0*SUM(w.clicks)/SUM(w.searches) AS naive_ctr_pct FROM query_week w JOIN query_category c ON w.query_id=c.query_id JOIN category_vertical v ON c.category=v.category WHERE w.week='2026-W41' AND v.vertical='shopping'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "searches", "clicks", "naive_ctr_pct"], "rows": [[1150, 137945, 56422, 40.901808691869945]]}
