{"id": "q4", "ts": 1793645955.942, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches<0 OR clicks<0 OR clicks>searches OR searches IS NULL OR clicks IS NULL THEN 1 ELSE 0 END) AS invalid FROM query_week GROUP BY week", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid"], "rows": [["2026-W41", 2000, 2000, 239240, 66152, 0]]}
{"id": "q5", "ts": 1793645965.842, "source": "runner", "sql": "SELECT COUNT(*) AS queries, SUM(CASE WHEN n>1 THEN 1 ELSE 0 END) AS repeated_queries, SUM(CASE WHEN cats>1 THEN 1 ELSE 0 END) AS conflicting_queries, SUM(n) AS mapping_rows FROM (SELECT query_id, COUNT(*) AS n, COUNT(DISTINCT category) AS cats FROM query_category GROUP BY query_id)", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["queries", "repeated_queries", "conflicting_queries", "mapping_rows"], "rows": [[2000, 250, 0, 2250]]}
{"id": "q6", "ts": 1793645965.866, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT w.query_id) AS matched_queries, SUM(CASE WHEN c.query_id IS NULL THEN 1 ELSE 0 END) AS unmatched_rows FROM query_week w LEFT JOIN query_category c ON w.query_id=c.query_id WHERE w.week='2026-W41'", "params": [], "as_of": "2026-W41", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "matched_queries", "unmatched_rows"], "rows": [[2250, 2000, 0]]}
