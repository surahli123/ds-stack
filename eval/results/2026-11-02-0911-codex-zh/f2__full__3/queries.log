{"id": "q1", "ts": 1793643684.688, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["name", "sql"], "rows": [["query_stats", "CREATE TABLE query_stats (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_labels", "CREATE TABLE query_labels (query_id INTEGER, intent TEXT, label_version INTEGER, is_current INTEGER)"]]}
{"id": "q2", "ts": 1793643691.396, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid FROM query_stats GROUP BY week ORDER BY week", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid"], "rows": [["2026-W40", 1000, 1000, 149500, 55307, 0]]}
{"id": "q3", "ts": 1793643691.456, "source": "runner", "sql": "SELECT intent, is_current, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, MIN(label_version) AS min_version, MAX(label_version) AS max_version FROM query_labels GROUP BY intent,is_current", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 4, "columns": ["intent", "is_current", "rows", "queries", "min_version", "max_version"], "rows": [["informational", 0, 100, 100, 1, 1], ["informational", 1, 600, 600, 1, 2], ["navigational", 0, 200, 200, 1, 1], ["navigational", 1, 400, 400, 1, 2]]}
{"id": "q4", "ts": 1793643697.548, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT s.query_id) AS distinct_queries, SUM(CASE WHEN l.query_id IS NOT NULL THEN 1 ELSE 0 END) AS matched_rows, SUM(CASE WHEN l.intent='navigational' THEN 1 ELSE 0 END) AS nav_queries, SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_searches, SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END) AS nav_clicks FROM query_stats s LEFT JOIN query_labels l ON s.query_id=l.query_id AND l.is_current=1 WHERE s.week='2026-W40'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "distinct_queries", "matched_rows", "nav_queries", "nav_searches", "nav_clicks"], "rows": [[1000, 1000, 1000, 400, 59800, 32878]]}
{"id": "q5", "ts": 1793643697.608, "source": "runner", "sql": "SELECT COUNT(*) AS current_rows, COUNT(DISTINCT query_id) AS current_distinct_keys FROM query_labels WHERE is_current=1", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["current_rows", "current_distinct_keys"], "rows": [[1000, 1000]]}
{"id": "q6", "ts": 1793643710.65, "source": "runner", "sql": "WITH a AS (SELECT SUM(s.clicks)*1.0 AS k, SUM(s.searches)*1.0 AS n FROM query_stats s WHERE s.week='2026-W40' AND EXISTS (SELECT 1 FROM query_labels l WHERE l.query_id=s.query_id AND l.is_current=1 AND l.intent='navigational')), b AS (SELECT k,n,k/n AS p, 3.841458820694 AS z2 FROM a) SELECT k,n,100*p AS ctr_percent,100*(p+z2/(2*n)-1.95996398454*sqrt(p*(1-p)/n+z2/(4*n*n)))/(1+z2/n) AS wilson_low_percent,100*(p+z2/(2*n)+1.95996398454*sqrt(p*(1-p)/n+z2/(4*n*n)))/(1+z2/n) AS wilson_high_percent FROM b", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.014, "row_count": 1, "columns": ["k", "n", "ctr_percent", "wilson_low_percent", "wilson_high_percent"], "rows": [[32878.0, 59800.0, 54.979933110367895, 54.58087409354669, 55.37835236199988]]}
