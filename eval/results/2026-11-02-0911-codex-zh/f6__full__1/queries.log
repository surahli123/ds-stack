{"id": "q2", "ts": 1793645237.065, "source": "runner", "sql": "SELECT date, traffic_type, COUNT(*) AS cells, SUM(searches) AS searches, SUM(searches_with_results) AS results, SUM(searches_with_click) AS clicked, SUM(clicks) AS clicks FROM search_daily_v GROUP BY date,traffic_type ORDER BY date,traffic_type", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 21, "columns": ["date", "traffic_type", "cells", "searches", "results", "clicked", "clicks"], "rows": [["2026-10-05", "bot", 2, 15111, 14915, 298, 298], ["2026-10-05", "external", 2, 100216, 92199, 46255, 64757], ["2026-10-05", "internal", 2, 4962, 4763, 3345, 5017], ["2026-10-06", "bot", 2, 15333, 15134, 302, 302], ["2026-10-06", "external", 2, 102451, 94255, 47240, 66136], ["2026-10-06", "internal", 2, 5212, 5003, 3505, 5257], ["2026-10-07", "bot", 2, 14860, 14667, 294, 294], ["2026-10-07", "external", 2, 97105, 89336, 44631, 62484], ["2026-10-07", "internal", 2, 4890, 4694, 3275, 4913], ["2026-10-08", "bot", 2, 15072, 14876, 297, 297], ["2026-10-08", "external", 2, 100215, 92198, 45983, 64376], ["2026-10-08", "internal", 2, 5051, 4849, 3403, 5105], ["2026-10-09", "bot", 2, 14500, 14312, 286, 286], ["2026-10-09", "external", 2, 97205, 89429, 44835, 62769], ["2026-10-09", "internal", 2, 4863, 4669, 3275, 4912], ["2026-10-10", "bot", 2, 14955, 14760, 295, 295], ["2026-10-10", "external", 2, 99533, 91570, 45772, 64081], ["2026-10-10", "internal", 2, 4964, 4766, 3323, 4984], ["2026-10-11", "bot", 2, 15286, 15087, 302, 302], ["2026-10-11", "external", 2, 102057, 93893, 47064, 65889], ["2026-10-11", "internal", 2, 5120, 4915, 3445, 5167]]}
{"id": "q3", "ts": 1793645245.521, "source": "runner", "sql": "WITH a AS (SELECT SUM(searches_with_click)*1.0 AS k, SUM(searches_with_results)*1.0 AS n, SUM(clicks) AS clicks, SUM(searches) AS searches FROM search_daily_v WHERE traffic_type='external' AND date >= '2026-10-05' AND date < '2026-10-12') SELECT k,n,100*k/n AS ctr_percent,100*((k/n+3.841458820694124/(2*n))-1.959963984540054*sqrt((k/n)*(1-k/n)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_lower_percent,100*((k/n+3.841458820694124/(2*n))+1.959963984540054*sqrt((k/n)*(1-k/n)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_upper_percent,100.0*clicks/n AS click_count_rate,100*k/searches AS all_search_rate FROM a", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["k", "n", "ctr_percent", "wilson_lower_percent", "wilson_upper_percent", "click_count_rate", "all_search_rate"], "rows": [[321780.0, 642880.0, 50.05288700846192, 49.93066407013767, 50.17510931474893, 70.07404181184668, 46.04869615988964]]}
{"id": "q4", "ts": 1793645245.544, "source": "runner", "sql": "SELECT MIN(date) AS first_date,MAX(date) AS last_date, COUNT(DISTINCT date) AS days,COUNT(*) AS cells, SUM(CASE WHEN searches_with_click<0 OR searches_with_results<searches_with_click OR searches<searches_with_results OR clicks<searches_with_click OR searches IS NULL OR searches_with_results IS NULL OR searches_with_click IS NULL OR clicks IS NULL THEN 1 ELSE 0 END) AS invalid_cells, COUNT(*)-COUNT(DISTINCT date||'|'||platform||'|'||traffic_type) AS duplicate_keys FROM search_daily_v", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["first_date", "last_date", "days", "cells", "invalid_cells", "duplicate_keys"], "rows": [["2026-10-05", "2026-10-11", 7, 42, 0, 0]]}
