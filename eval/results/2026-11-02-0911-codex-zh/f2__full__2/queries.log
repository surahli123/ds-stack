{"id": "q1", "ts": 1793643605.597, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["name", "sql"], "rows": [["query_stats", "CREATE TABLE query_stats (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_labels", "CREATE TABLE query_labels (query_id INTEGER, intent TEXT, label_version INTEGER, is_current INTEGER)"]]}
{"id": "q2", "ts": 1793643614.86, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid_rows FROM query_stats GROUP BY week ORDER BY week", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid_rows"], "rows": [["2026-W40", 1000, 1000, 149500, 55307, 0]]}
{"id": "q3", "ts": 1793643614.861, "source": "runner", "sql": "SELECT intent, label_version, is_current, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries FROM query_labels GROUP BY intent, label_version, is_current", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 6, "columns": ["intent", "label_version", "is_current", "rows", "queries"], "rows": [["informational", 1, 0, 100, 100], ["informational", 1, 1, 400, 400], ["informational", 2, 1, 200, 200], ["navigational", 1, 0, 200, 200], ["navigational", 1, 1, 300, 300], ["navigational", 2, 1, 100, 100]]}
{"id": "q4", "ts": 1793643621.715, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT s.query_id) AS distinct_queries, SUM(CASE WHEN l.query_id IS NOT NULL THEN 1 ELSE 0 END) AS matched_rows, SUM(CASE WHEN l.intent='navigational' THEN 1 ELSE 0 END) AS nav_queries, SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_searches, SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END) AS nav_clicks FROM query_stats s LEFT JOIN query_labels l ON s.query_id=l.query_id AND l.is_current=1 WHERE s.week='2026-W40'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "distinct_queries", "matched_rows", "nav_queries", "nav_searches", "nav_clicks"], "rows": [[1000, 1000, 1000, 400, 59800, 32878]]}
{"id": "q5", "ts": 1793643621.738, "source": "runner", "sql": "SELECT COUNT(*) AS current_rows, COUNT(DISTINCT query_id) AS current_keys FROM query_labels WHERE is_current=1", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["current_rows", "current_keys"], "rows": [[1000, 1000]]}
{"id": "q6", "ts": 1793643633.779, "source": "runner", "sql": "WITH totals AS (SELECT SUM(s.clicks)*1.0 AS k, SUM(s.searches)*1.0 AS n FROM query_stats s WHERE week='2026-W40' AND EXISTS (SELECT 1 FROM query_labels l WHERE l.query_id=s.query_id AND l.is_current=1 AND l.intent='navigational')), rate AS (SELECT k,n,k/n AS p FROM totals) SELECT k,n,100*p AS ctr_percent,100*(p+3.841458820694124/(2*n)-1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_low_percent,100*(p+3.841458820694124/(2*n)+1.959963984540054*sqrt(p*(1-p)/n+3.841458820694124/(4*n*n)))/(1+3.841458820694124/n) AS wilson_high_percent FROM rate", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.014, "row_count": 1, "columns": ["k", "n", "ctr_percent", "wilson_low_percent", "wilson_high_percent"], "rows": [[32878.0, 59800.0, 54.979933110367895, 54.580874093546676, 55.378352361999895]]}
