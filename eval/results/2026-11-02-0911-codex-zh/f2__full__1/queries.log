{"id": "q1", "ts": 1793643583.446, "source": "runner", "sql": "SELECT name, sql FROM sqlite_master WHERE type='table'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 2, "columns": ["name", "sql"], "rows": [["query_stats", "CREATE TABLE query_stats (query_id INTEGER, week TEXT, searches INTEGER, clicks INTEGER)"], ["query_labels", "CREATE TABLE query_labels (query_id INTEGER, intent TEXT, label_version INTEGER, is_current INTEGER)"]]}
{"id": "q2", "ts": 1793643592.57, "source": "runner", "sql": "SELECT week, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries, SUM(searches) AS searches, SUM(clicks) AS clicks, SUM(CASE WHEN searches IS NULL OR clicks IS NULL OR searches<0 OR clicks<0 OR clicks>searches THEN 1 ELSE 0 END) AS invalid_rows FROM query_stats GROUP BY week ORDER BY week", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["week", "rows", "queries", "searches", "clicks", "invalid_rows"], "rows": [["2026-W40", 1000, 1000, 149500, 55307, 0]]}
{"id": "q3", "ts": 1793643592.594, "source": "runner", "sql": "SELECT intent, label_version, is_current, COUNT(*) AS rows, COUNT(DISTINCT query_id) AS queries FROM query_labels GROUP BY intent,label_version,is_current", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 6, "columns": ["intent", "label_version", "is_current", "rows", "queries"], "rows": [["informational", 1, 0, 100, 100], ["informational", 1, 1, 400, 400], ["informational", 2, 1, 200, 200], ["navigational", 1, 0, 200, 200], ["navigational", 1, 1, 300, 300], ["navigational", 2, 1, 100, 100]]}
{"id": "q4", "ts": 1793643601.209, "source": "runner", "sql": "SELECT COUNT(*) AS label_rows, COUNT(DISTINCT query_id) AS label_keys FROM query_labels WHERE is_current=1", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["label_rows", "label_keys"], "rows": [[1000, 1000]]}
{"id": "q5", "ts": 1793643601.233, "source": "runner", "sql": "SELECT COUNT(*) AS joined_rows, COUNT(DISTINCT s.query_id) AS query_keys, COUNT(l.query_id) AS matched_rows, SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_searches, SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END) AS nav_clicks, SUM(CASE WHEN l.intent='navigational' THEN 1 ELSE 0 END) AS nav_queries, 100.0*SUM(CASE WHEN l.intent='navigational' THEN s.clicks ELSE 0 END)/SUM(CASE WHEN l.intent='navigational' THEN s.searches ELSE 0 END) AS nav_ctr_pct FROM query_stats s LEFT JOIN query_labels l ON s.query_id=l.query_id AND l.is_current=1 WHERE s.week='2026-W40'", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.001, "row_count": 1, "columns": ["joined_rows", "query_keys", "matched_rows", "nav_searches", "nav_clicks", "nav_queries", "nav_ctr_pct"], "rows": [[1000, 1000, 1000, 59800, 32878, 400, 54.979933110367895]]}
{"id": "q6", "ts": 1793643610.722, "source": "runner", "sql": "WITH a AS (SELECT SUM(s.clicks)*1.0 AS k, SUM(s.searches)*1.0 AS n FROM query_stats s WHERE s.week='2026-W40' AND EXISTS (SELECT 1 FROM query_labels l WHERE l.query_id=s.query_id AND l.is_current=1 AND l.intent='navigational')), b AS (SELECT n,k,k/n AS p,3.841458820694124 AS z2 FROM a) SELECT 100*p AS ctr_pct,100*(p+z2/(2*n)-1.959963984540054*sqrt(p*(1-p)/n+z2/(4*n*n)))/(1+z2/n) AS ci95_low_pct,100*(p+z2/(2*n)+1.959963984540054*sqrt(p*(1-p)/n+z2/(4*n*n)))/(1+z2/n) AS ci95_high_pct FROM b", "params": [], "as_of": "2026-10-04", "status": "ok", "seconds": 0.013, "row_count": 1, "columns": ["ctr_pct", "ci95_low_pct", "ci95_high_pct"], "rows": [[54.979933110367895, 54.580874093546676, 55.378352361999895]]}
