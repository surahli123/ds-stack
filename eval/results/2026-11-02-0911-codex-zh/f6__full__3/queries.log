{"id": "q5", "ts": 1793645333.618, "source": "runner", "sql": "WITH a AS (SELECT 1.0*SUM(searches_with_click) AS k, 1.0*SUM(searches_with_results) AS n FROM search_daily_v WHERE traffic_type='external' AND date BETWEEN '2026-10-05' AND '2026-10-11'), b AS (SELECT n, k/n AS p, 1.959963984540054 AS z FROM a) SELECT 100*p AS ctr_pct, 100*(p+z*z/(2*n)-z*sqrt(p*(1-p)/n+z*z/(4*n*n)))/(1+z*z/n) AS wilson_low_pct, 100*(p+z*z/(2*n)+z*sqrt(p*(1-p)/n+z*z/(4*n*n)))/(1+z*z/n) AS wilson_high_pct FROM b", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["ctr_pct", "wilson_low_pct", "wilson_high_pct"], "rows": [[50.05288700846192, 49.93066407013767, 50.17510931474893]]}
