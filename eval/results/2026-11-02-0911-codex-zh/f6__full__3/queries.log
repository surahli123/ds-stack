{"id": "q2", "ts": 1793645320.736, "source": "runner", "sql": "SELECT date, traffic_type, COUNT(*) AS rows_n, SUM(searches) AS searches, SUM(searches_with_results) AS results, SUM(searches_with_click) AS clicked, SUM(clicks) AS clicks FROM search_daily_v GROUP BY date, traffic_type ORDER BY date, traffic_type", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 21, "columns": ["date", "traffic_type", "rows_n", "searches", "results", "clicked", "clicks"], "rows": [["2026-10-05", "bot", 2, 15111, 14915, 298, 298], ["2026-10-05", "external", 2, 100216, 92199, 46255, 64757], ["2026-10-05", "internal", 2, 4962, 4763, 3345, 5017], ["2026-10-06", "bot", 2, 15333, 15134, 302, 302], ["2026-10-06", "external", 2, 102451, 94255, 47240, 66136], ["2026-10-06", "internal", 2, 5212, 5003, 3505, 5257], ["2026-10-07", "bot", 2, 14860, 14667, 294, 294], ["2026-10-07", "external", 2, 97105, 89336, 44631, 62484], ["2026-10-07", "internal", 2, 4890, 4694, 3275, 4913], ["2026-10-08", "bot", 2, 15072, 14876, 297, 297], ["2026-10-08", "external", 2, 100215, 92198, 45983, 64376], ["2026-10-08", "internal", 2, 5051, 4849, 3403, 5105], ["2026-10-09", "bot", 2, 14500, 14312, 286, 286], ["2026-10-09", "external", 2, 97205, 89429, 44835, 62769], ["2026-10-09", "internal", 2, 4863, 4669, 3275, 4912], ["2026-10-10", "bot", 2, 14955, 14760, 295, 295], ["2026-10-10", "external", 2, 99533, 91570, 45772, 64081], ["2026-10-10", "internal", 2, 4964, 4766, 3323, 4984], ["2026-10-11", "bot", 2, 15286, 15087, 302, 302], ["2026-10-11", "external", 2, 102057, 93893, 47064, 65889], ["2026-10-11", "internal", 2, 5120, 4915, 3445, 5167]]}
{"id": "q3", "ts": 1793645333.574, "source": "runner", "sql": "SELECT COUNT(*) AS rows_n, COUNT(DISTINCT date) AS days_n, MIN(date) AS first_day, MAX(date) AS last_day, SUM(searches_with_click) AS k, SUM(searches_with_results) AS n, 100.0*SUM(searches_with_click)/SUM(searches_with_results) AS ctr_pct, SUM(CASE WHEN searches_with_click IS NULL OR searches_with_results IS NULL OR searches_with_click < 0 OR searches_with_click > searches_with_results OR searches_with_results > searches THEN 1 ELSE 0 END) AS invalid_rows FROM search_daily_v WHERE traffic_type='external' AND date BETWEEN '2026-10-05' AND '2026-10-11'", "params": [], "as_of": "2026-10-11", "status": "ok", "seconds": 0.0, "row_count": 1, "columns": ["rows_n", "days_n", "first_day", "last_day", "k", "n", "ctr_pct", "invalid_rows"], "rows": [[14, 7, "2026-10-05", "2026-10-11", 321780, 642880, 50.05288700846192, 0]]}
